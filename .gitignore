# ── Dependencies & build output ─────────────────────────────
node_modules/
dist/
dist-ssr/
coverage/
*.tsbuildinfo
*.local

# ── Logs ────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*

# ── Environment & secrets ───────────────────────────────────
# Never commit secrets. Only .example files are tracked.
.env
.env.*
*.env
!.env.example
!*.env.example
*.pem
*.p12

# ── Editors & OS ────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.cursor/
.DS_Store

# ── AI-agent local config (never commit — may hold tokens) ──
.claude/
.mcp.json
.opencode/

# ── Supabase upstream clone (pinned via database/SUPABASE_VERSION,
#    materialized by database/scripts/sync-supabase.sh — never tracked) ──
database/supabase/

# ── Databases (local snapshots) ─────────────────────────────
*.db
*.db.wal
*.sqlite
!database/migrations/*.sql

# ── tesseract.js language-data cache (downloaded at runtime) ──
*.traineddata

# ── Forge (coursegen) generation run artifacts —
#    checkpoints/ledgers/rubrics, never tracked (COURSE_ENGINE.md §4) ──
coursegen/runs/

# ── Echo (audiogen) character voice reference samples — large binary audio,
#    never tracked. Trimmed/registration output also stays local-only. ──
audiogen/src/samples/
.vercel
.env*
# Re-assert the .env.example allow AFTER the broad `.env*` above — later
# patterns win, so without this every service's placeholder .env.example
# (which §1.10 REQUIRES to be tracked) silently falls out of git. This bit
# pulse/.env.example on 2026-07-21; the earlier 8 were only grandfathered in.
!.env.example
!*.env.example

# AI agent workspaces
.agents/
.claude/
.codex/

# Production database dumps (PII + credential hashes — never commit)
/database/backups/
