# ── Dependencies & build output ─────────────────────────────
node_modules/
dist/
dist-ssr/
coverage/
*.tsbuildinfo
*.local

# ── Logs ────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*

# ── Environment & secrets ───────────────────────────────────
# Never commit secrets. Only .example files are tracked.
.env
.env.*
*.env
!.env.example
!*.env.example
*.pem
*.p12

# ── Editors & OS ────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.cursor/
.DS_Store

# ── AI-agent local config (never commit — may hold tokens) ──
.claude/
.mcp.json
.opencode/

# ── Legal working docs (root only — MUST stay anchored with
#    the leading slash: an unanchored `LEGAL/` once ignored
#    frontend/src/**/legal/ and broke the production build) ──
/LEGAL/

# ── Supabase upstream clone (pinned via database/SUPABASE_VERSION,
#    materialized by database/scripts/sync-supabase.sh — never tracked) ──
database/supabase/

# ── Databases (local snapshots) ─────────────────────────────
*.db
*.sqlite
!database/migrations/*.sql

# ── tesseract.js language-data cache (downloaded at runtime) ──
*.traineddata
