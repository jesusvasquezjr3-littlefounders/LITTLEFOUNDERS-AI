# Dependencies and build output
node_modules/
dist/
dist-ssr/
coverage/
*.tsbuildinfo
*.local
.lane-cache/

# Logs
logs/
*.log
npm-debug.log*

# Environment and secrets: only .env.example files are tracked
.env
.env.*
*.env
!.env.example
!*.env.example
*.pem
*.p12
.vercel

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
.cursor/
.DS_Store
Thumbs.db

# AI agent workspaces and local config (never commit: may hold tokens)
.claude/*
!.claude/skills/
.agents/
.codex/
.mcp.json
.opencode/

# Supabase upstream clone, pinned by database/SUPABASE_VERSION and
# materialized by database/scripts/sync-supabase.sh
database/supabase/

# Database dumps hold personal data
/database/backups/
*.dump
*.dump.lfbk

# Local snapshots and generated reports
*.db
*.db.wal
*.sqlite
audit-results/
output/


# Python bytecode
__pycache__/
*.pyc

