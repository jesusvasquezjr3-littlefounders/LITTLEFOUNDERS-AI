{
  "name": "@littlefounders/audiogen",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "UNLICENSED",
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "narrate:all": "tsx --env-file-if-exists=.env src/narrateAll.ts",
    "trim:samples": "tsx scripts/trim-samples.ts",
    "voices:register": "tsx --env-file-if-exists=.env scripts/register-character-voices.ts"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "express": "^5.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.0",
    "eslint": "^9.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
