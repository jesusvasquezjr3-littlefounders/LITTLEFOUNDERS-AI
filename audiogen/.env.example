PORT=4002

# Service-to-service auth (shared with internal services, /AGENTS.md §1.5)
INTERNAL_API_KEY=replace-me

# TTS provider — DashScope (Qwen3-TTS), decision RESOLVED (see AGENTS.md)
TTS_API_URL=https://dashscope-intl.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
TTS_API_KEY=replace-me
TTS_MODEL=qwen3-tts-flash

# Voice-clone ENROLLMENT (a different endpoint from synthesis above) + the
# model a cloned voice is bound to. DashScope requires target_model at
# enrollment to exactly match the model used at synthesis time, so every
# character-override voice below is ALWAYS synthesized with this model, never
# TTS_MODEL. See src/tts/voiceClone.ts + scripts/register-character-voices.ts.
TTS_ENROLLMENT_API_URL=https://dashscope-intl.aliyuncs.com/api/v1/services/audio/tts/customization
TTS_CLONE_MODEL=qwen3-tts-vc-2026-01-22

# Per-locale default voices — used whenever a segment has no narrator, or
# the narrator's character has no override below for that locale.
TTS_VOICE_EN_US=Jennifer
TTS_VOICE_ES_MX=Li
TTS_VOICE_PT_BR=Ryan

# Per-character x per-locale voice overrides (the "voice map", COURSE_ENGINE.md
# §7 — "voice = the segment's narrator character"). ALL OPTIONAL: leave unset
# to fall back to the locale default above. Each value is a cloned-voice id
# returned by `npm run voices:register` — always paired with TTS_CLONE_MODEL
# at synthesis time, never TTS_MODEL. See README.md "Voice map".
# TTS_VOICE_DINA_EN_US=
# TTS_VOICE_DINA_ES_MX=
# TTS_VOICE_DINA_PT_BR=
# TTS_VOICE_LIRUF_EN_US=
# TTS_VOICE_LIRUF_ES_MX=
# TTS_VOICE_LIRUF_PT_BR=
# TTS_VOICE_RHO_EN_US=
# TTS_VOICE_RHO_ES_MX=
# TTS_VOICE_RHO_PT_BR=
# TTS_VOICE_ZARA_EN_US=
# TTS_VOICE_ZARA_ES_MX=
# TTS_VOICE_ZARA_PT_BR=

# Vault (Supabase self-hosted stack) — service role, bypasses RLS
SUPABASE_URL=http://localhost:8000
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Filebase — internal upload service
FILEBASE_URL=http://localhost:4006
FILEBASE_INTERNAL_KEY=replace-me

# Batch narration — OPERATOR-OPT-IN, calls the paid TTS API for every
# published lesson missing audio. Never enable in CI/dev by default.
AUDIOGEN_RUN_ON_START=false
AUDIOGEN_CONCURRENCY=2
AUDIOGEN_MP3_BITRATE_KBPS=48
