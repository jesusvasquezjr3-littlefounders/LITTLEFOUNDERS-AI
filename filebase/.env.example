PORT=4006

# Service-to-service (/AGENTS.md §1.5) — must match every caller's
# (Core, Forge/coursegen, Echo/audiogen) INTERNAL_API_KEY value.
INTERNAL_API_KEY=replace-me

# Storage root. Local dev: a folder on disk. Production (Railway): the
# mount path of the attached persistent volume — see README.md.
FILEBASE_ROOT=./data

# Max accepted upload size, in bytes (default 25MB).
FILEBASE_MAX_BYTES=26214400

# Optional. Absolute base URL used to build public download URLs (e.g. the
# Railway public domain, https://filebase.up.railway.app). If unset, the
# `url` field in upload responses is a root-relative path.
#
# Genuinely optional keys are COMMENTED OUT, never assigned empty: Zod's
# `.url().optional()` allows undefined but not '', so an empty assignment is
# a present value that fails its own validator (same class of bug oracle/
# fixed for its own optional keys — see oracle/.env.example's header).
# PUBLIC_BASE_URL=https://filebase.up.railway.app
