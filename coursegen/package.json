{
  "name": "@littlefounders/coursegen",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate": "tsx --env-file-if-exists=.env src/cli.ts",
    "generate:track": "tsx --env-file-if-exists=.env src/trackCli.ts",
    "coach": "tsx src/coachCli.ts",
    "images:backfill": "tsx --env-file-if-exists=.env src/scripts/backfill-images.ts",
    "images:apply-map": "tsx --env-file-if-exists=.env src/scripts/apply-image-map.ts",
    "author:briefs": "tsx src/scripts/author-briefs.ts",
    "author:validate": "tsx src/scripts/author-validate.ts",
    "author:judge": "tsx src/scripts/author-judge.ts",
    "author:localize": "tsx src/scripts/author-localize.ts",
    "author:publish": "tsx --env-file-if-exists=.env.production src/scripts/author-publish.ts",
    "catalog:check": "tsx src/catalog/check.ts",
    "graph:check": "tsx src/catalog/graphCheck.ts",
    "contract:check": "tsx src/contract/check.ts",
    "content:gates": "tsx src/contentGates/cli.ts",
    "verify:course": "tsx --env-file-if-exists=.env src/verifyCourse.ts",
    "graph:backfill": "tsx --env-file-if-exists=.env.production src/scripts/backfill-graph.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "yaml": "^2.4.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.0",
    "eslint": "^9.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
