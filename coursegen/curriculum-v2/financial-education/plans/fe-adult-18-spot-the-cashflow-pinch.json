      "copy": {
        "en-US": {
          "prompt": "Balance $200; $350 is due on day 5; $500 arrives day 12. What happens first?",
          "help": [
            "Put income and payments on dates to find a temporary negative balance."
          ],
          "feedback": {
            "met": "Correct. Your evidence applies the lesson rule.",
            "not_yet": "Not yet. Apply the lesson rule to every shown fact."
          },
          "choices": [
            {
              "label": "A $150 timing gap"
            },
            {
              "label": "A $350 surplus"
            },
            {
              "label": "No gap because income is later"
            }
          ],
          "reasonPrompt": "Which reason supports that answer?",
          "reasons": [
            {
              "label": "Order cash by date; find negatives"
            },
            {
              "label": "It uses only one visible number"
            },
            {
              "label": "It simply looks larger"
            }
          ]
        },
