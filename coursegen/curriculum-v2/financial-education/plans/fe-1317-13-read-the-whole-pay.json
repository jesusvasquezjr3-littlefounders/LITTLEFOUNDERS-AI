      "copy": {
        "en-US": {
          "prompt": "Maya opens a pay record with earnings, deductions and take-home pay. (farmers market)",
          "line": "Take-home pay equals all earnings minus every shown deduction."
        },
        "es-MX": {
          "prompt": "Maya abre un registro con ingreso, deducciones y pago neto. (tianguis)",
          "line": "El pago neto es todo lo ganado menos cada deducción mostrada."
        },
        "pt-BR": {
          "prompt": "Maya abre um registro com ganho, descontos e pagamento líquido. (padaria)",
          "line": "O pagamento líquido é todo o ganho menos cada desconto mostrado."
        }
      }
    },
    {
      "id": "pre-01",
      "type": "reasoning.decide-justify.v2",
