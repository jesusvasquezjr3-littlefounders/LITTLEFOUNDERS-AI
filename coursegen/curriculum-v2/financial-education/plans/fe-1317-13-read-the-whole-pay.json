      "copy": {
        "en-US": {
          "prompt": "A pay record shows 96 coins earned and 12 withheld. What is take-home pay?",
          "feedback": {
            "met": "You rebuilt take-home pay from the complete record.",
            "not_yet": "Not yet. Use every shown fact, then choose again."
          },
          "choices": [
            {
              "label": "84 coins take-home"
            },
            {
              "label": "Use only the largest number"
            },
            {
              "label": "Decide without checking the record"
            }
          ],
          "reasonPrompt": "Which evidence supports the choice?",
          "reasons": [
            {
              "label": "Subtract every shown deduction"
            },
            {
              "label": "It uses only one fact"
            },
            {
              "label": "It ignores the record"
            }
          ]
        },
        "es-MX": {
          "prompt": "El registro muestra 96 monedas ganadas y 12 descontadas. ¿Cuál es el pago neto?",
          "feedback": {
            "met": "Reconstruiste el pago neto con el registro completo.",
            "not_yet": "Todavía no. Usa todos los datos y vuelve a elegir."
          },
          "choices": [
            {
              "label": "84 monedas netas"
            },
            {
              "label": "Usar sólo el número mayor"
            },
            {
              "label": "Decidir sin revisar el registro"
            }
          ],
          "reasonPrompt": "¿Qué evidencia apoya la elección?",
          "reasons": [
            {
              "label": "Resta cada deducción mostrada"
            },
            {
              "label": "Usa sólo un dato"
            },
            {
              "label": "Ignora el registro"
            }
          ]
        },
        "pt-BR": {
          "prompt": "O registro mostra 96 moedas ganhas e 12 descontadas. Qual é o pagamento líquido?",
          "feedback": {
            "met": "Você reconstruiu o pagamento líquido com o registro completo.",
            "not_yet": "Ainda não. Use todos os dados e escolha novamente."
          },
          "choices": [
            {
              "label": "84 moedas líquidas"
            },
            {
              "label": "Usar apenas o maior número"
            },
            {
              "label": "Decidir sem conferir o registro"
            }
          ],
          "reasonPrompt": "Qual evidência apoia a escolha?",
          "reasons": [
            {
              "label": "Subtraia cada desconto mostrado"
            },
            {
              "label": "Usa apenas um dado"
            },
            {
              "label": "Ignora o registro"
            }
          ]
        }
      }
    },
