  "brief": "Lee el pago completo. El pago neto es todo lo ganado menos cada deducción mostrada. El sondeo, la práctica guiada, la práctica independiente y la transferencia usan cuatro casos distintos y evidencian life.track-earnings.",
  "title": {
    "en-US": "Read the whole pay",
    "es-MX": "Lee el pago completo",
    "pt-BR": "Leia o pagamento inteiro"
  },
  "new_concepts": [],
  "regional": {
    "scenarios": {
      "en-US": {
        "scenario": "Maya works weekends at a bakery stall at a farmers market. In the US most jobs open at 14, with limited hours until 16 and often a work permit. Amounts are illustrative coin values, not real wages.",
        "problem_refs": [
          "us-parent-silence"
        ],
        "anchors": [
          "farmers market",
          "work permit"
        ]
      },
      "es-MX": {
        "scenario": "Maya trabaja los fines de semana en un puesto de pan del tianguis. En México se trabaja desde los 15 años; antes de los 16 se necesita permiso de los padres o tutores y jornadas más cortas. Las cantidades son monedas ilustrativas, no sueldos reales.",
        "problem_refs": [
          "mx-access-without-wellbeing"
        ],
        "anchors": [
          "tianguis",
          "puesto de pan"
        ]
      },
      "pt-BR": {
        "scenario": "Maya trabalha nos fins de semana no balcão de uma padaria de bairro. No Brasil o trabalho começa aos 16 anos, ou aos 14 como aprendiz, e antes dos 18 não pode ser noturno. Os valores são moedas ilustrativas, não salários reais.",
        "problem_refs": [
          "br-baseline-literacy-gap"
        ],
        "anchors": [
          "padaria",
          "aprendiz"
        ]
      }
    }
  },
