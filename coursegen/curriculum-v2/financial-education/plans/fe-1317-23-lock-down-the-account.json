      "es-MX": {
        "scenario": "En México los adolescentes reciben avisos de paquetería que cobran un envío por link y compradores de apps de compra y venta que pagan de más, piden la devolución y mandan una captura de SPEI. Se practican esas trampas con remitentes y links inventados y se termina sin pagar y avisando a la plataforma.",
        "problem_refs": [
          "mx-access-without-wellbeing"
        ],
        "anchors": [
          "SPEI"
        ]
      },
      "pt-BR": {
        "scenario": "No Brasil circulam avisos de encomenda com cobrança por link e compradores de apps de compra e venda que pagam a mais, pedem a devolução por Pix e mostram um comprovante falso. Só remetentes e links inventados, e o fecho é não pagar e denunciar no app.",
        "problem_refs": [
          "br-instant-payments"
        ],
        "anchors": [
          "Pix"
        ]
      },
      "en-US": {
        "scenario": "In the US teens get parcel texts that charge a redelivery fee through a link, and resale buyers who overpay, ask for a refund by payment app and send a screenshot. Only made-up senders and links; it ends with not paying and reporting it.",
        "problem_refs": [
          "us-access-not-judgment"
        ],
        "anchors": [
          "payment app"
        ]
      }
    }
