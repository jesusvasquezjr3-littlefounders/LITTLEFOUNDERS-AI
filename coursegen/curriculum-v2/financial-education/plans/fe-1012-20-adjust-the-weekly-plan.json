      "copy": {
        "en-US": {
          "prompt": "Rho: Has 30; plan costs 18 + 15. Which change makes it fit?",
          "feedback": {
            "met": "Yes. The shown facts support it.",
            "not_yet": "Check all shown facts. Try again."
          },
          "choices": [
            {
              "label": "Lower 15 to 12"
            },
            {
              "label": "Raise 18 to 20"
            },
            {
              "label": "Add a 4 cost"
            }
          ],
          "reasonPrompt": "What proves it?",
          "reasons": [
            {
              "label": "18 + 12 = 30"
            },
            {
              "label": "Keep every cost unchanged"
            },
            {
              "label": "Ignore the total"
            }
          ]
        },
        "es-MX": {
          "prompt": "Rho: Tiene 30; el plan cuesta 18 + 15. ¿Qué cambio hace que alcance?",
          "feedback": {
            "met": "Sí. Esa regla cuida bien.",
            "not_yet": "Mira el riesgo y la regla."
          },
          "choices": [
            {
              "label": "Bajar 15 a 12"
            },
            {
              "label": "Subir 18 a 20"
            },
            {
              "label": "Agregar un costo de 4"
            }
          ],
          "reasonPrompt": "¿Qué lo prueba?",
          "reasons": [
            {
              "label": "18 + 12 = 30"
            },
            {
              "label": "Dejar todos los costos iguales"
            },
            {
              "label": "Ignorar el total"
            }
          ]
        },
        "pt-BR": {
          "prompt": "Rho: Tem 30; o plano custa 18 + 15. Qual mudança faz caber?",
          "feedback": {
            "met": "Sim. Os dados apoiam.",
            "not_yet": "Veja os dados. Tente de novo."
          },
          "choices": [
            {
              "label": "Reduzir 15 para 12"
            },
            {
              "label": "Aumentar 18 para 20"
            },
            {
              "label": "Adicionar custo 4"
            }
          ],
          "reasonPrompt": "O que prova?",
          "reasons": [
            {
              "label": "18 + 12 = 30"
            },
            {
              "label": "Manter todos os custos iguais"
            },
            {
              "label": "Ignorar o total"
            }
          ]
        }
      }
