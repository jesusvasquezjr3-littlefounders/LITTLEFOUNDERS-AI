  "brief": "Las comisiones cambian todo. Compara cuentas después de sumar comisiones recurrentes y de uso. El sondeo, la práctica guiada, la práctica independiente y la transferencia usan cuatro casos distintos y evidencian life.recurring-costs.",
  "title": {
    "en-US": "Fees change the choice",
    "es-MX": "Las comisiones cambian todo",
    "pt-BR": "Tarifas mudam a escolha"
  },
  "new_concepts": [],
  "regional": {
    "scenarios": {
      "en-US": {
        "scenario": "Dina compares two phone plans. In the US a monthly plan often has a data cap, and a prepaid plan is the alternative. Amounts are illustrative coin values, not real prices or wages.",
        "problem_refs": [
          "us-access-not-judgment"
        ],
        "anchors": [
          "data cap",
          "prepaid"
        ]
      },
      "es-MX": {
        "scenario": "Dina compara dos planes de celular. En México se puede pagar un plan de renta cada mes o comprar una recarga de saldo, y el plan trae un límite de datos. Las cantidades son monedas ilustrativas, no precios ni sueldos reales.",
        "problem_refs": [
          "mx-access-without-wellbeing"
        ],
        "anchors": [
          "plan de renta",
          "recarga"
        ]
      },
      "pt-BR": {
        "scenario": "Dina compara dois planos de celular. No Brasil existem o plano pré-pago e o plano controle, com valor mensal fixo e pacote de dados. Os valores são moedas ilustrativas, não preços nem salários reais.",
        "problem_refs": [
          "br-baseline-literacy-gap"
        ],
        "anchors": [
          "plano controle",
          "pré-pago"
        ]
      }
    }
  },
