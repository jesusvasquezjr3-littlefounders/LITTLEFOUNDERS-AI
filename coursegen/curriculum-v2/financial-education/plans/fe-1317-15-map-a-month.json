      "copy": {
        "en-US": {
          "prompt": "Dina puts monthly income, costs and saving on one map.",
          "line": "Income minus planned costs and saving must finish at zero or above."
        },
        "es-MX": {
          "prompt": "Dina pone ingreso, costos y ahorro del mes en un solo mapa.",
          "line": "Ingreso menos costos y ahorro debe terminar en cero o más."
        },
        "pt-BR": {
          "prompt": "Dina coloca renda, custos e reserva do mês em um só mapa.",
          "line": "Renda menos custos e reserva deve terminar em zero ou mais."
        }
      }
    },
    {
      "id": "pre-01",
      "type": "reasoning.decide-justify.v2",
