      "copy": {
        "en-US": {
          "prompt": "Monthly income is 240; costs are 150 and saving is 40. What remains?",
          "feedback": {
            "met": "You mapped income, costs and saving without overspending.",
            "not_yet": "Not yet. Use every shown fact, then choose again."
          },
          "choices": [
            {
              "label": "50 coins remain"
            },
            {
              "label": "Use only the largest number"
            },
            {
              "label": "Decide without checking the record"
            }
          ],
          "reasonPrompt": "Which evidence supports the choice?",
          "reasons": [
            {
              "label": "Subtract costs and saving from income"
            },
            {
              "label": "It uses only one fact"
            },
            {
              "label": "It ignores the record"
            }
          ]
        },
        "es-MX": {
          "prompt": "El ingreso mensual es 240; los costos son 150 y el ahorro 40. ¿Cuánto queda?",
          "feedback": {
            "met": "Trazaste ingreso, costos y ahorro sin gastar de más.",
            "not_yet": "Todavía no. Usa todos los datos y vuelve a elegir."
          },
          "choices": [
            {
              "label": "Quedan 50 monedas"
            },
            {
              "label": "Usar sólo el número mayor"
            },
            {
              "label": "Decidir sin revisar el registro"
            }
          ],
          "reasonPrompt": "¿Qué evidencia apoya la elección?",
          "reasons": [
            {
              "label": "Resta costos y ahorro del ingreso"
            },
            {
              "label": "Usa sólo un dato"
            },
            {
              "label": "Ignora el registro"
            }
          ]
        },
        "pt-BR": {
          "prompt": "A renda mensal é 240; os custos são 150 e a reserva 40. Quanto sobra?",
          "feedback": {
            "met": "Você mapeou renda, custos e reserva sem gastar demais.",
            "not_yet": "Ainda não. Use todos os dados e escolha novamente."
          },
          "choices": [
            {
              "label": "Sobram 50 moedas"
            },
            {
              "label": "Usar apenas o maior número"
            },
            {
              "label": "Decidir sem conferir o registro"
            }
          ],
          "reasonPrompt": "Qual evidência apoia a escolha?",
          "reasons": [
            {
              "label": "Subtraia custos e reserva da renda"
            },
            {
              "label": "Usa apenas um dado"
            },
            {
              "label": "Ignora o registro"
            }
          ]
        }
      }
    },
