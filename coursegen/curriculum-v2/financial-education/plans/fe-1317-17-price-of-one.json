  "brief": "Compara el precio de uno. El precio unitario es el precio total entre las unidades iguales. El sondeo, la práctica guiada, la práctica independiente y la transferencia usan cuatro casos distintos y evidencian money.unit-price.",
  "title": {
    "en-US": "Compare the price of one",
    "es-MX": "Compara el precio de uno",
    "pt-BR": "Compare o preço de um"
  },
  "new_concepts": [
    "money.unit-price"
  ],
  "regional": {
    "scenarios": {
      "es-MX": {
        "scenario": "Liruf compra en la tiendita de doña Lupe y en el tianguis, donde la misma fruta o bebida viene en bolsas y paquetes de tamaños distintos y el efectivo se cuenta a la vista. La decisión final usa pan del día, que se echa a perder.",
        "problem_refs": [
          "mx-cash-and-informal-commerce"
        ],
        "anchors": [
          "tiendita",
          "tianguis"
        ]
      },
      "en-US": {
        "scenario": "Liruf shops at the corner store, where the same snack or school item comes in packs of different sizes; a child can get the choice wrong with coins already in hand. The final decision uses notebooks, which keep, so the big pack wins here.",
        "problem_refs": [
          "us-access-not-judgment"
        ],
        "anchors": [
          "corner store"
        ]
      },
      "pt-BR": {
        "scenario": "Liruf compra na padaria do seu Zé e na feira livre do bairro, onde o mesmo produto vem em sacos e pacotes de tamanhos diferentes; comparar o preço de cada unidade é um fundamento que não se supõe aprendido. A decisão final usa pão de hot dog, que endurece, então o pacote pequeno vence.",
        "problem_refs": [
          "br-baseline-literacy-gap"
        ],
        "anchors": [
          "padaria",
          "feira livre"
        ]
      }
    }
  },
