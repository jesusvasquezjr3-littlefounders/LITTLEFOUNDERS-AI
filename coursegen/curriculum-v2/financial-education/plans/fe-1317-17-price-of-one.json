      "copy": {
        "en-US": {
          "prompt": "Zara compares packs only after finding the price of one equal item. (corner store)",
          "line": "Unit price is total price divided by the number of equal items."
        },
        "es-MX": {
          "prompt": "Zara compara paquetes sólo después de hallar el precio de una unidad. (tiendita)",
          "line": "El precio unitario es el precio total entre las unidades iguales."
        },
        "pt-BR": {
          "prompt": "Zara compara pacotes só depois de achar o preço de uma unidade. (padaria)",
          "line": "Preço unitário é o preço total dividido pelas unidades iguais."
        }
      }
