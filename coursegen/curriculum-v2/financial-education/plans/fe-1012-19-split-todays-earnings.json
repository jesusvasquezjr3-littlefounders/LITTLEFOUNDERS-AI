        "en-US": {
          "prompt": "Liruf: Earned 20. Save 10, spend 6, share 4. Does it use all?",
          "feedback": {
            "met": "Yes. The shown facts support it.",
            "not_yet": "Check all shown facts. Try again."
          },
          "choices": [
            {
              "label": "Yes: total 20"
            },
            {
              "label": "Yes: total 22"
            },
            {
              "label": "Count only saving"
            }
          ],
          "reasonPrompt": "What proves it?",
          "reasons": [
            {
              "label": "10 + 6 + 4 = 20"
            },
            {
              "label": "It uses only one number"
            },
            {
              "label": "It is the biggest option"
            }
          ]
        },
        "es-MX": {
          "prompt": "Liruf: Ganó 20. Ahorra 10, gasta 6, comparte 4. ¿Usa todo?",
          "feedback": {
            "met": "Sí. La suma da eso.",
            "not_yet": "Haz la suma otra vez."
          },
          "choices": [
            {
              "label": "Sí: total 20"
            },
            {
              "label": "Sí: total 22"
            },
            {
              "label": "Contar sólo ahorro"
            }
          ],
          "reasonPrompt": "¿Qué lo prueba?",
          "reasons": [
            {
              "label": "10 + 6 + 4 = 20"
            },
            {
              "label": "Usa sólo un número"
            },
            {
              "label": "Es la opción mayor"
            }
