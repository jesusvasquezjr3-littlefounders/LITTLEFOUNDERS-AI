      "copy": {
        "en-US": {
          "prompt": "Zara turns monthly service prices into full-year totals. (data cap)",
          "line": "Full-year cost is monthly cost times 12 plus every stated fee."
        },
        "es-MX": {
          "prompt": "Zara convierte precios mensuales en totales del año. (plan de renta)",
          "line": "El costo anual es el mensual por 12 más cada comisión indicada."
        },
        "pt-BR": {
          "prompt": "Zara transforma preços mensais em totais do ano. (plano controle)",
          "line": "O custo anual é o mensal vezes 12 mais cada tarifa informada."
        }
      }
    },
