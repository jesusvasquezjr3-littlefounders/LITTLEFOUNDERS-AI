      "copy": {
        "en-US": {
          "prompt": "A service costs 7 monthly plus a 18 annual fee. What is the full-year cost?",
          "feedback": {
            "met": "You compared the complete year, including stated fees.",
            "not_yet": "Not yet. Use every shown fact, then choose again."
          },
          "choices": [
            {
              "label": "102 coins for the year"
            },
            {
              "label": "Use only the largest number"
            },
            {
              "label": "Decide without checking the record"
            }
          ],
          "reasonPrompt": "Which evidence supports the choice?",
          "reasons": [
            {
              "label": "Multiply monthly cost; add fees"
            },
            {
              "label": "It uses only one fact"
            },
            {
              "label": "It ignores the record"
            }
          ]
        },
        "es-MX": {
          "prompt": "Un servicio cuesta 7 al mes más una comisión anual de 18. ¿Cuál es el costo del año?",
          "feedback": {
            "met": "Comparaste el año completo, incluidas las comisiones.",
            "not_yet": "Todavía no. Usa todos los datos y vuelve a elegir."
          },
          "choices": [
            {
              "label": "102 monedas por el año"
            },
            {
              "label": "Usar sólo el número mayor"
            },
            {
              "label": "Decidir sin revisar el registro"
            }
          ],
          "reasonPrompt": "¿Qué evidencia apoya la elección?",
          "reasons": [
            {
              "label": "Multiplica costo mensual; suma comisiones"
            },
            {
              "label": "Usa sólo un dato"
            },
            {
              "label": "Ignora el registro"
            }
          ]
        },
        "pt-BR": {
          "prompt": "Um serviço custa 7 por mês mais uma tarifa anual de 18. Qual é o custo do ano?",
          "feedback": {
            "met": "Você comparou o ano completo, incluindo as tarifas.",
            "not_yet": "Ainda não. Use todos os dados e escolha novamente."
          },
          "choices": [
            {
              "label": "102 moedas no ano"
            },
            {
              "label": "Usar apenas o maior número"
            },
            {
              "label": "Decidir sem conferir o registro"
            }
          ],
          "reasonPrompt": "Qual evidência apoia a escolha?",
          "reasons": [
