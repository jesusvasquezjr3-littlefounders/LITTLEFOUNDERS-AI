        "en-US": {
          "prompt": "Buffer target is 120; 30 is saved and each contribution is 15. How many more contributions?",
          "feedback": {
            "met": "You connected the buffer target to repeated contributions.",
            "not_yet": "Not yet. Use every shown fact, then choose again."
          },
          "choices": [
            {
              "label": "6 contributions"
            },
            {
              "label": "Use only the largest number"
            },
            {
              "label": "Decide without checking the record"
            }
          ],
          "reasonPrompt": "Which evidence supports the choice?",
          "reasons": [
            {
              "label": "Find gap; divide by each contribution"
            },
            {
              "label": "It uses only one fact"
            },
            {
              "label": "It ignores the record"
            }
          ]
        },
        "es-MX": {
          "prompt": "La meta es 120; hay 30 y cada aporte es 15. ¿Cuántos aportes faltan?",
          "feedback": {
            "met": "Conectaste la meta del colchón con aportes repetidos.",
            "not_yet": "Todavía no. Usa todos los datos y vuelve a elegir."
          },
          "choices": [
            {
              "label": "6 aportes"
            },
            {
              "label": "Usar sólo el número mayor"
            },
            {
              "label": "Decidir sin revisar el registro"
            }
          ],
          "reasonPrompt": "¿Qué evidencia apoya la elección?",
          "reasons": [
            {
              "label": "Halla brecha; divide entre cada aporte"
            },
            {
              "label": "Usa sólo un dato"
            },
            {
              "label": "Ignora el registro"
            }
          ]
        },
        "pt-BR": {
          "prompt": "A meta é 120; há 30 e cada contribuição é 15. Quantas faltam?",
          "feedback": {
