  "brief": "Lee el registro de cuenta. Saldo inicial más depósitos menos compras debe dar el saldo final. El sondeo, la práctica guiada, la práctica independiente y la transferencia usan cuatro casos distintos y evidencian life.banks-and-accounts.",
  "title": {
    "en-US": "Read the account record",
    "es-MX": "Lee el registro de cuenta",
    "pt-BR": "Leia o registro da conta"
  },
  "new_concepts": [],
  "regional": {
    "scenarios": {
      "en-US": {
        "scenario": "Maya opens a first account with a parent. In the US a teen often has a joint checking account with a parent and a debit card with a PIN. Account rules and amounts are illustrative coin values, not advice about any bank.",
        "problem_refs": [
          "us-access-not-judgment"
        ],
        "anchors": [
          "debit card",
          "checking account"
        ]
      },
      "es-MX": {
        "scenario": "Maya abre su primera cuenta con uno de sus padres. En México muchos bancos ofrecen cuentas para menores con tarjeta de débito y NIP, y las reglas cambian según el banco. Las cantidades son monedas ilustrativas, no consejo sobre ningún banco.",
        "problem_refs": [
          "mx-access-without-wellbeing"
        ],
        "anchors": [
          "tarjeta de débito",
          "NIP"
        ]
      },
      "pt-BR": {
        "scenario": "Maya abre a primeira conta com um dos pais. No Brasil, bancos oferecem contas para menores com cartão de débito e senha, e as regras mudam conforme o banco. Os valores são moedas ilustrativas, não conselho sobre nenhum banco.",
        "problem_refs": [
          "br-baseline-literacy-gap"
        ],
        "anchors": [
          "cartão de débito",
          "senha"
        ]
      }
    }
  },
