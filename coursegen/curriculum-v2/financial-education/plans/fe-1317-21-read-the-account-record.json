      "copy": {
        "en-US": {
          "prompt": "Rho matches a personal log against an account record line by line. (debit card)",
          "line": "Start balance plus deposits minus purchases must equal the ending balance."
        },
        "es-MX": {
          "prompt": "Rho compara un registro personal con la cuenta, línea por línea. (tarjeta de débito)",
          "line": "Saldo inicial más depósitos menos compras debe dar el saldo final."
        },
        "pt-BR": {
          "prompt": "Rho compara um registro pessoal com a conta, linha por linha. (cartão de débito)",
          "line": "Saldo inicial mais depósitos menos compras deve dar o saldo final."
        }
      }
    },
    {
      "id": "pre-01",
      "type": "reasoning.decide-justify.v2",
