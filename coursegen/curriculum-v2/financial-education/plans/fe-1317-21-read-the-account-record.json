      "copy": {
        "en-US": {
          "prompt": "Account starts at 70, receives 25 and spends 18. What ending balance belongs in the record?",
          "feedback": {
            "met": "You reconciled every entry and found the correct ending balance.",
            "not_yet": "Not yet. Use every shown fact, then choose again."
          },
          "choices": [
            {
              "label": "77 coins"
            },
            {
              "label": "Use only the largest number"
            },
            {
              "label": "Decide without checking the record"
            }
          ],
          "reasonPrompt": "Which evidence supports the choice?",
          "reasons": [
            {
              "label": "Add deposits; subtract purchases"
            },
            {
              "label": "It uses only one fact"
            },
            {
              "label": "It ignores the record"
            }
          ]
        },
        "es-MX": {
          "prompt": "La cuenta inicia en 70, recibe 25 y gasta 18. ¿Qué saldo final corresponde?",
          "feedback": {
            "met": "Cuadraste cada movimiento y hallaste el saldo final.",
            "not_yet": "Todavía no. Usa todos los datos y vuelve a elegir."
          },
          "choices": [
            {
              "label": "77 monedas"
            },
            {
              "label": "Usar sólo el número mayor"
            },
            {
              "label": "Decidir sin revisar el registro"
            }
          ],
          "reasonPrompt": "¿Qué evidencia apoya la elección?",
          "reasons": [
            {
              "label": "Suma depósitos; resta compras"
            },
            {
              "label": "Usa sólo un dato"
            },
            {
              "label": "Ignora el registro"
            }
          ]
        },
        "pt-BR": {
          "prompt": "A conta começa em 70, recebe 25 e gasta 18. Qual saldo final corresponde?",
          "feedback": {
            "met": "Você conciliou cada lançamento e achou o saldo final.",
            "not_yet": "Ainda não. Use todos os dados e escolha novamente."
          },
          "choices": [
            {
              "label": "77 moedas"
            },
            {
              "label": "Usar apenas o maior número"
            },
            {
              "label": "Decidir sem conferir o registro"
            }
          ],
          "reasonPrompt": "Qual evidência apoia a escolha?",
          "reasons": [
            {
              "label": "Some depósitos; subtraia compras"
            },
            {
              "label": "Usa apenas um dado"
            },
            {
              "label": "Ignora o registro"
            }
          ]
        }
      }
    },
