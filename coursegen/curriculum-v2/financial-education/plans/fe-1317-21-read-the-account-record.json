          "prompt": "Watch the rule on a new case.",
          "line": "A 90 start plus 20 in minus 35 out gives 90 + 20 − 35 = 75."
        },
        "es-MX": {
          "prompt": "Mira la regla en un caso nuevo.",
          "line": "Saldo 90 más 20 de entrada menos 35 de salida da 90 + 20 − 35 = 75."
        },
        "pt-BR": {
          "prompt": "Veja a regra em um caso novo.",
          "line": "Saldo 90 mais 20 de entrada menos 35 de saída dá 90 + 20 − 35 = 75."
        }
      }
