{
  "publication_intent": "calibration-only",
  "version": 1,
  "course_id": "financial-education",
  "pathway_id": "financial-adult",
  "age_band": "adult",
  "metadata": {
    "title": {
      "en-US": "Financial Education",
      "es-MX": "Educación Financiera",
      "pt-BR": "Educação Financeira"
    },
    "description": {
      "en-US": "Build practical foundations for everyday money decisions.",
      "es-MX": "Construye bases prácticas para decidir sobre tu dinero cotidiano.",
      "pt-BR": "Construa bases práticas para decidir sobre seu dinheiro cotidiano."
    },
    "subject": "money",
    "position": 1,
    "badge_asset": "course-badges/financial-education.png",
    "requires": []
  },
  "scope": "Adult financial foundations: progress from usable money and feasible plans to saving, borrowing, percentage calculations, purchasing power, modeled growth, basic investment risk and informed consumer decisions. This is a bounded foundation course, not a claim to exhaust financial knowledge or qualify a learner to advise others.",
  "excluded_scope": [
    "Personal financial or investment recommendations",
    "Current product offers, forecasts or market returns",
    "Jurisdiction-specific tax filing, benefit eligibility and deposit-insurance limits",
    "Advanced securities valuation, derivatives and professional financial advice",
    "Child and teen pathways; family wallet operations"
  ],
  "units": [
    {
      "id": "fe-solid-01-money-today",
      "title": {
        "en-US": "Money available today",
        "es-MX": "Dinero disponible hoy",
        "pt-BR": "Dinheiro disponível hoje"
      },
      "objective": "Track received money, balance, reservations and payment dates before planning a purchase."
    },
    {
      "id": "fe-solid-02-a-plan-that-fits",
      "title": {
        "en-US": "A plan that fits",
        "es-MX": "Un plan que sí cabe",
        "pt-BR": "Um plano que cabe"
      },
      "objective": "Prioritize by consequences and revise a feasible plan under uncertainty and predictable future costs."
    },
    {
      "id": "fe-solid-03-compare-before-paying",
      "title": {
        "en-US": "Compare before paying",
        "es-MX": "Compara antes de pagar",
        "pt-BR": "Compare antes de pagar"
      },
      "objective": "Compare equal units, percentage shares and complete prices rather than advertising headlines."
    },
    {
      "id": "fe-solid-04-save-with-a-purpose",
      "title": {
        "en-US": "Save with a purpose",
        "es-MX": "Ahorra con propósito",
        "pt-BR": "Poupe com um propósito"
      },
      "objective": "Prepare goals and unexpected needs while checking real contribution capacity and access conditions."
    },
    {
      "id": "fe-solid-05-understand-borrowing",
      "title": {
        "en-US": "Understand borrowing",
        "es-MX": "Comprende los préstamos",
        "pt-BR": "Entenda os empréstimos"
      },
      "objective": "Distinguish income from debt and calculate total obligations, period interest and remaining balances."
    },
    {
      "id": "fe-solid-06-money-over-time",
      "title": {
        "en-US": "Money over time",
        "es-MX": "El dinero con el tiempo",
        "pt-BR": "O dinheiro com o tempo"
      },
      "objective": "Distinguish purchasing power and modeled compound growth from nominal amounts and guarantees."
    },
    {
      "id": "fe-solid-07-risk-and-protection",
      "title": {
        "en-US": "Risk and protection",
        "es-MX": "Riesgo y protección",
        "pt-BR": "Risco e proteção"
      },
      "objective": "Check time horizons, concentration and claims of safe returns without recommending products."
    },
    {
      "id": "fe-solid-08-decide-with-evidence",
      "title": {
        "en-US": "Decide with evidence",
        "es-MX": "Decide con información",
        "pt-BR": "Decida com informação"
      },
      "objective": "Protect credentials, read complete terms and apply prior skills in integrated decisions."
    }
  ],
  "sources": [
    {
      "url": "https://www.consumerfinance.gov/ask-cfpb/what-are-some-classic-warning-signs-of-possible-fraud-and-scams-en-2094/",
      "use": "Independent identity verification and pressured-payment warning signs; no US reporting procedure is presented as universal."
    },
    {
      "url": "https://www.consumerfinance.gov/ask-cfpb/i-received-an-email-from-my-bank-or-credit-union-asking-me-to-verify-my-account-information-what-should-i-do-en-999/",
      "use": "Protecting credentials and verifying account messages through a separate official channel."
    },
    {
      "url": "https://www.condusef.gob.mx/?idc=2023&idcat=1&p=contenido",
      "use": "Compare actual financial product costs, conditions and service information rather than advertisements alone."
    },
    {
      "url": "https://www.consumerfinance.gov/consumer-tools/educator-tools/your-money-your-goals/toolkit/",
      "use": "Coverage of goals, income, bills, cash flow, debt, products and protection; US legal rules are not exported to other markets."
    },
    {
      "url": "https://www.fdic.gov/consumer-resource-center/money-smart-adults",
      "use": "Adult financial capability coverage; adapted into prerequisite-led micro-lessons rather than copied module order."
    },
    {
      "url": "https://www.oecd.org/en/publications/financial-competence-framework-for-adults-in-the-european-union_510f133c-en.html",
      "use": "Competency coverage reference; bounded course scope does not claim complete professional financial competence."
    },
    {
      "url": "https://webappsos.condusef.gob.mx/EducaTuCartera/presupuesto.html",
      "use": "Mexican financial education reference for budgeting and distinguishing actual resources from planned spending."
    },
    {
      "url": "https://www.consumerfinance.gov/consumer-tools/credit-cards/answers/key-terms/",
      "use": "Borrowing vocabulary and the distinction between balances, minimum payments and borrowing charges; contractual examples remain explicitly fictional."
    },
    {
      "url": "https://www.investor.gov/introduction-investing",
      "use": "Compound growth and investment risk concepts; examples make no return promises or product recommendations."
    },
    {
      "url": "https://www.investor.gov/additional-resources/general-resources/publications-research/info-sheets/beginners-guide-asset",
      "use": "Time horizon and diversification concepts, including the limits of diversification."
    },
    {
      "url": "https://ies.ed.gov/ncee/wwc/PracticeGuide/1",
      "use": "Instructional sequence with worked examples, independent practice and later retrieval; no claim of measured learner outcomes."
    }
  ],
  "skills": [
    {
      "id": "cash.direction",
      "knowledge_component_id": "finance.cash.direction",
