        "cash.balance",
        "plan.priority"
      ]
    },
    {
      "id": "price.percent",
      "knowledge_component_id": "finance.price.percent",
      "domain": "purchasing",
      "outcome": "Calculate a percentage amount using the stated whole and equal hundredths.",
