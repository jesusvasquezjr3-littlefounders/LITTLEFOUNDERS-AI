        "cash.reserved",
        "cash.dates"
      ]
    },
    {
      "id": "plan.uncertain-income",
      "knowledge_component_id": "finance.plan.uncertain-income",
      "domain": "planning",
      "outcome": "Revise spending that depends on an uncertain or canceled receipt.",
