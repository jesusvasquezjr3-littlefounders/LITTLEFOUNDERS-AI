PORT=4001

# ---- Author / judge providers (required only for `npm run generate`; the
# /health service and all offline commands — catalog:check, contract:check,
# tests — never need these) ----
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

QWEN_API_KEY=replace-me
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_JUDGE_MODEL=qwen3-max

# Prism (picturegen/, port 4007) — the ONLY image source (Gemini discarded
# 2026-07-23: quota-0 on every Google image model). Unset = illustrate stage
# skips cleanly (icons remain the fallback).
# PICTUREGEN_URL=http://localhost:4007
# PICTUREGEN_INTERNAL_KEY=replace-with-shared-internal-key

# ---- Vault writes (publish stage — service role, bypasses RLS on purpose) ----
SUPABASE_URL=http://localhost:8000
SUPABASE_SERVICE_ROLE_KEY=replace-me

# ---- filebase (lesson-images upload, images stage) ----
FILEBASE_URL=http://localhost:4006
FILEBASE_INTERNAL_KEY=replace-me

# ---- Service-to-service ----
INTERNAL_API_KEY=replace-me
BACKEND_INTERNAL_URL=http://localhost:4000

# ---- Run budgets / concurrency (COURSE_ENGINE.md §4 kill switches) ----
FORGE_MAX_TOKENS_PER_RUN=5000000
FORGE_MAX_USD_PER_RUN=50
FORGE_CONCURRENCY=2
# Per-LLM-call abort ceiling (ms). Default 120000; bump per-run for known-heavy
# lessons (e.g. FORGE_CHAT_TIMEOUT_MS=300000 for a long ordering-lesson mop-up).
# FORGE_CHAT_TIMEOUT_MS=120000

# ---- Cost table overrides (USD per 1K tokens / per image) — optional,
# defaults verified against official price pages 2026-07-25 (deepseek-v4-pro /
# DashScope), override if pricing changes. *_INPUT_CACHED_* = the rate for
# prompt tokens served by the provider's automatic context cache (DeepSeek
# prompt_cache_hit_tokens; DashScope prompt_tokens_details.cached_tokens) ----
# COST_DEEPSEEK_INPUT_PER_1K=0.000435
# COST_DEEPSEEK_INPUT_CACHED_PER_1K=0.0000036
# COST_DEEPSEEK_OUTPUT_PER_1K=0.00087
# COST_QWEN_INPUT_PER_1K=0.0016
# COST_QWEN_INPUT_CACHED_PER_1K=0.00032
# COST_QWEN_OUTPUT_PER_1K=0.0064
# COST_QWEN_IMAGE_PER_IMAGE=0.035
