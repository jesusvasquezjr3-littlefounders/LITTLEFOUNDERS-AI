{
  "plan_version": 1,
  "course_id": "financial-education",
  "pathway_id": "financial-13-17",
  "chapter_id": "reading-money-charts",
  "lesson_id": "v2-teaching-charts",
  "age_band": "13-17",
  "eligibility": { "minimum_age": 13, "maximum_age": 17 },
  "knowledge_component_ids": ["kc-money-flow", "kc-running-balance"],
  "adventure_scene_id": "diorama-a",
  "brief": "Una adolescente sigue su dinero del mes con gráficas: de dónde viene, cómo cambia el saldo y cuántos días practicó.",
  "title": { "en-US": "Read your money charts", "es-MX": "Lee tus gráficas de dinero", "pt-BR": "Leia seus gráficos de dinheiro" },
  "new_concepts": ["kc-money-flow"],
  "regional": { "universal": "Uses LittleFounders coins only; no market amounts, places or customs." },
  "segments": [
    {
      "id": "flow-01", "type": "visual.chart.v2", "grading": "none", "visual": { "type": "sankey" },
      "knowledge_component_id": "kc-money-flow",
      "payload": { "data": { "unit": "coins", "nodes": [{ "id": "node-income" }, { "id": "node-save" }, { "id": "node-spend" }, { "id": "node-share" }],
        "links": [{ "from": "node-income", "to": "node-save", "value": 30 }, { "from": "node-income", "to": "node-spend", "value": 50 }, { "from": "node-income", "to": "node-share", "value": 20 }] } },
      "copy": {
        "en-US": { "prompt": "Follow where 100 coins went.", "title": "Where the coins went", "data": { "nodes": [{ "label": "Income" }, { "label": "Save" }, { "label": "Spend" }, { "label": "Share" }] } },
        "es-MX": { "prompt": "Sigue a dónde fueron 100 monedas.", "title": "A dónde fueron", "data": { "nodes": [{ "label": "Ingreso" }, { "label": "Guardar" }, { "label": "Gastar" }, { "label": "Compartir" }] } },
        "pt-BR": { "prompt": "Siga para onde foram 100 moedas.", "title": "Para onde foram", "data": { "nodes": [{ "label": "Renda" }, { "label": "Guardar" }, { "label": "Gastar" }, { "label": "Compartilhar" }] } }
      }
    },
    {
      "id": "balance-01", "type": "visual.chart.v2", "grading": "server", "visual": { "type": "waterfall" },
      "item_role": "practice", "knowledge_component_id": "kc-running-balance",
      "payload": { "data": { "unit": "coins", "categories": [{ "id": "step-allowance" }, { "id": "step-snacks" }, { "id": "step-gift" }, { "id": "step-chores" }],
        "series": [{ "id": "series-change", "values": [50, -15, -10, 20] }] },
        "question": { "options": [{ "id": "opt-45" }, { "id": "opt-55" }, { "id": "opt-35" }] } },
      "rubric": { "acceptable_choice_ids": ["opt-45"] },
      "copy": {
        "en-US": { "prompt": "Read the steps from left to right.", "feedback": {"met": "You followed each step of the chart to the final balance.", "not_yet": "Not yet. Add the rises and take away the drops in order."}, "title": "How the balance changed", "data": { "categories": [{ "label": "Allowance" }, { "label": "Snacks" }, { "label": "Gift" }, { "label": "Chores" }], "series": [{ "label": "Change" }] },
          "question": { "prompt": "What is the balance at the end?", "options": [{ "label": "45 coins" }, { "label": "55 coins" }, { "label": "35 coins" }] } },
        "es-MX": { "prompt": "Lee los pasos de izquierda a derecha.", "feedback": {"met": "Seguiste cada paso de la gráfica hasta el saldo final.", "not_yet": "Todavía no. Suma las subidas y resta las bajadas en orden."}, "title": "Cómo cambió el saldo", "data": { "categories": [{ "label": "Domingo" }, { "label": "Botanas" }, { "label": "Regalo" }, { "label": "Tareas" }], "series": [{ "label": "Cambio" }] },
          "question": { "prompt": "¿Cuál es el saldo al final?", "options": [{ "label": "45 monedas" }, { "label": "55 monedas" }, { "label": "35 monedas" }] } },
        "pt-BR": { "prompt": "Leia os passos da esquerda para a direita.", "feedback": {"met": "Você seguiu cada passo do gráfico até o saldo final.", "not_yet": "Ainda não. Some as subidas e tire as descidas, em ordem."}, "title": "Como o saldo mudou", "data": { "categories": [{ "label": "Mesada" }, { "label": "Lanches" }, { "label": "Presente" }, { "label": "Tarefas" }], "series": [{ "label": "Mudança" }] },
          "question": { "prompt": "Qual é o saldo no final?", "options": [{ "label": "45 moedas" }, { "label": "55 moedas" }, { "label": "35 moedas" }] } }
      }
    },
    {
      "id": "rate-01", "type": "visual.chart.v2", "grading": "none", "visual": { "type": "step" },
      "payload": { "data": { "unit": "percent", "categories": [{ "id": "month-1" }, { "id": "month-2" }, { "id": "month-3" }, { "id": "month-4" }],
        "series": [{ "id": "series-rate", "values": [2, 2, 3, 3] }] } },
      "copy": {
        "en-US": { "prompt": "The savings rate changes in steps.", "title": "Savings rate", "data": { "categories": [{ "label": "Month 1" }, { "label": "Month 2" }, { "label": "Month 3" }, { "label": "Month 4" }], "series": [{ "label": "Rate" }] } },
        "es-MX": { "prompt": "La tasa de ahorro cambia por escalones.", "title": "Tasa de ahorro", "data": { "categories": [{ "label": "Mes 1" }, { "label": "Mes 2" }, { "label": "Mes 3" }, { "label": "Mes 4" }], "series": [{ "label": "Tasa" }] } },
        "pt-BR": { "prompt": "A taxa de poupança muda em degraus.", "title": "Taxa de poupança", "data": { "categories": [{ "label": "Mês 1" }, { "label": "Mês 2" }, { "label": "Mês 3" }, { "label": "Mês 4" }], "series": [{ "label": "Taxa" }] } }
      }
    },
    {
      "id": "days-01", "type": "visual.chart.v2", "grading": "none", "visual": { "type": "calendar-heatmap" },
      "payload": { "data": { "unit": "count", "days": [
        { "date": "2026-09-07", "value": 1 }, { "date": "2026-09-08", "value": 0 }, { "date": "2026-09-09", "value": 2 }, { "date": "2026-09-10", "value": 1 },
        { "date": "2026-09-11", "value": 0 }, { "date": "2026-09-12", "value": 3 }, { "date": "2026-09-13", "value": 1 }, { "date": "2026-09-14", "value": 2 },
        { "date": "2026-09-15", "value": 1 }, { "date": "2026-09-16", "value": 0 }, { "date": "2026-09-17", "value": 1 }, { "date": "2026-09-18", "value": 2 },
        { "date": "2026-09-19", "value": 0 }, { "date": "2026-09-20", "value": 1 }] } },
      "copy": {
        "en-US": { "prompt": "Darker days had more lessons.", "title": "Two weeks of practice" },
        "es-MX": { "prompt": "Los días más oscuros tuvieron más lecciones.", "title": "Dos semanas de práctica" },
        "pt-BR": { "prompt": "Os dias mais escuros tiveram mais lições.", "title": "Duas semanas de prática" }
      }
    },
    {
      "id": "total-01", "type": "visual.chart.v2", "grading": "none", "visual": { "type": "stat-tile" },
      "payload": { "data": { "unit": "coins", "stat": { "value": 120, "delta": 15 } } },
      "copy": {
        "en-US": { "prompt": "One number can sum up the month.", "title": "Saved this month" },
        "es-MX": { "prompt": "Un número puede resumir el mes.", "title": "Ahorrado este mes" },
        "pt-BR": { "prompt": "Um número pode resumir o mês.", "title": "Guardado este mês" }
      }
    }
  ]
}
