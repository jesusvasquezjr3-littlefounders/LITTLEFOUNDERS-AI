          {
            "upToMinor": 10000,
            "rateBasisPoints": 1000
          },
          {
            "upToMinor": 30000,
            "rateBasisPoints": 2000
          },
          {
            "upToMinor": null,
            "rateBasisPoints": 3000
          }
        ]
      },
      "copy": {
        "en-US": {
          "prompt": "Move the income to 45000 coins. Find the tax, the top rate and the average rate."
        },
        "es-MX": {
          "prompt": "Mueve el ingreso a 45000 monedas. Halla el impuesto, la tasa más alta y la tasa promedio."
        },
        "pt-BR": {
          "prompt": "Mova a renda para 45000 moedas. Ache o imposto, a maior alíquota e a alíquota média."
        }
      },
      "rubric": {
        "income_minor": 45000,
        "average_tolerance_bps": 50
      }
    },
    {
      "id": "adult-growth-01",
      "type": "visual.growth-comparison.v2",
      "grading": "server",
