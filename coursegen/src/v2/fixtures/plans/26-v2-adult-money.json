        "initialYears": 10,
        "predictionStepMinor": 1000,
        "predictionMaximumMinor": 1000000
      },
      "copy": {
        "en-US": {
          "prompt": "Predict the compound total, then reveal both curves."
        },
        "es-MX": {
          "prompt": "Predice el total compuesto y luego revela ambas curvas."
        },
        "pt-BR": {
          "prompt": "Preveja o total composto e depois revele as duas curvas."
        }
      },
      "rubric": {
        "tolerance_minor": 5000
      }
    },
    {
      "id": "adult-percent-01",
      "type": "visual.percent-grid.v2",
