      "payload": {
        "baseUnits": 200,
        "step": 10,
        "initialPercent": 0,
        "mode": "discount",
        "currency": "coins"
      },
      "copy": {
        "en-US": {
          "prompt": "A coat costs 200 coins with 30% off. Shade the discount."
        },
        "es-MX": {
          "prompt": "Un abrigo cuesta 200 monedas con 30% de descuento. Sombrea el descuento."
        },
        "pt-BR": {
          "prompt": "Um casaco custa 200 moedas com 30% de desconto. Pinte o desconto."
        }
      },
      "rubric": {
        "target_percent": 30
      }
    },
    {
      "id": "adult-ledger-01",
      "type": "money.running-ledger.v2",
      "grading": "server",
      "visual": {
        "type": "balance-meter"
      },
      "payload": {
        "initial": 10,
        "sale": 5,
        "cost": 3,
        "maxEntries": 6
      },
      "copy": {
        "en-US": {
          "prompt": "Start with 10 coins. Log sales of 5 and costs of 3 until you have 14."
        },
        "es-MX": {
          "prompt": "Empieza con 10 monedas. Anota ventas de 5 y gastos de 3 hasta tener 14."
        },
        "pt-BR": {
          "prompt": "Comece com 10 moedas. Anote vendas de 5 e custos de 3 até ter 14."
        }
      },
      "rubric": {
        "target_balance": 14
      }
    },
    {
      "id": "adult-worked-01",
      "type": "math.worked-example.v2",
      "grading": "server",
      "visual": {
        "type": "worked-example"
      },
      "payload": {
        "steps": [
          {
            "id": "discount-part"
