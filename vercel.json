{
    "build": {
        "env": {
            "PYO3_USE_ABI3_FORWARD_COMPATIBILITY": "1"
        }
    },
    "functions": {
        "api/index.py": {
            "includeFiles": "backend/**",
            "excludeFiles": "{backend/docs/**,backend/scripts/**,backend/migrations/**,backend/generated_lessons/**,**.md,**.sql}"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.py"
        },
        {
            "source": "/(.*)",
            "destination": "/dist/$1"
        }
    ]
}