{
    "buildCommand": "cd frontend && npm install && npm run build",
    "outputDirectory": "frontend/dist",
    "rewrites": [
        {
            "source": "/((?!api/).*)",
            "has": [
                {
                    "type": "host",
                    "value": "en.littlefounders.ai"
                }
            ],
            "destination": "/index-en.html"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ]
}