{
    "framework": null,
    "outputDirectory": "dist",
    "buildCommand": "cd frontend && npm install && npm run build && mkdir -p ../dist && cp -r dist/* ../dist",
    "build": {
        "env": {
            "PYO3_USE_ABI3_FORWARD_COMPATIBILITY": "1"
        }
    },
    "builds": [
        {
            "src": "api/index.py",
            "use": "@vercel/python",
            "config": {
                "maxLambdaSize": "50mb"
            }
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/index.py"
        },
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "/dist/$1"
        }
    ]
}