{
  "model": "rest-days-v1",
  "note": "Shared vectors for the habit streak model (B.21, S05.3e). backend/src/services/habitStreak.ts and the SQL function habit_streak_advance must both produce every expectation below. Backend tests run them in Core; database/scripts/test-habit-streak.sql runs them in PostgreSQL. 2026-09-21 is a Monday.",
  "advance": [
    { "name": "first practice ever", "state": { "current": 0, "best": 0, "lastActiveDate": null, "restDaysUsed": 0, "daysPracticed": 0 }, "today": "2026-09-24", "pauses": [],
      "expect": { "current": 1, "best": 1, "lastActiveDate": "2026-09-24", "restDaysUsed": 0, "daysPracticed": 1, "outcome": "first", "restDaysBridged": 0, "milestone": null } },
    { "name": "a second lesson the same day changes nothing", "state": { "current": 3, "best": 5, "lastActiveDate": "2026-09-24", "restDaysUsed": 1, "daysPracticed": 9 }, "today": "2026-09-24", "pauses": [],
      "expect": { "current": 3, "best": 5, "lastActiveDate": "2026-09-24", "restDaysUsed": 1, "daysPracticed": 9, "outcome": "same_day", "restDaysBridged": 0, "milestone": null } },
    { "name": "same day with a zeroed run counts as day one", "state": { "current": 0, "best": 4, "lastActiveDate": "2026-09-24", "restDaysUsed": 0, "daysPracticed": 4 }, "today": "2026-09-24", "pauses": [],
      "expect": { "current": 1, "best": 4, "lastActiveDate": "2026-09-24", "restDaysUsed": 0, "daysPracticed": 4, "outcome": "same_day", "restDaysBridged": 0, "milestone": null } },
    { "name": "the next day extends", "state": { "current": 3, "best": 3, "lastActiveDate": "2026-09-23", "restDaysUsed": 0, "daysPracticed": 3 }, "today": "2026-09-24", "pauses": [],
      "expect": { "current": 4, "best": 4, "lastActiveDate": "2026-09-24", "restDaysUsed": 0, "daysPracticed": 4, "outcome": "extended", "restDaysBridged": 0, "milestone": null } },
    { "name": "one missed day is a rest day", "state": { "current": 3, "best": 3, "lastActiveDate": "2026-09-22", "restDaysUsed": 0, "daysPracticed": 3 }, "today": "2026-09-24", "pauses": [],
      "expect": { "current": 4, "best": 4, "lastActiveDate": "2026-09-24", "restDaysUsed": 1, "daysPracticed": 4, "outcome": "bridged", "restDaysBridged": 1, "milestone": null } },
    { "name": "two missed days in one week are both rest days", "state": { "current": 3, "best": 3, "lastActiveDate": "2026-09-21", "restDaysUsed": 0, "daysPracticed": 3 }, "today": "2026-09-24", "pauses": [],
      "expect": { "current": 4, "best": 4, "lastActiveDate": "2026-09-24", "restDaysUsed": 2, "daysPracticed": 4, "outcome": "bridged", "restDaysBridged": 2, "milestone": null } },
    { "name": "a third missed day in one week rests the run", "state": { "current": 3, "best": 3, "lastActiveDate": "2026-09-21", "restDaysUsed": 0, "daysPracticed": 3 }, "today": "2026-09-25", "pauses": [],
      "expect": { "current": 1, "best": 3, "lastActiveDate": "2026-09-25", "restDaysUsed": 0, "daysPracticed": 4, "outcome": "restarted", "restDaysBridged": 0, "milestone": null } },
    { "name": "rest days already used this week count", "state": { "current": 5, "best": 5, "lastActiveDate": "2026-09-23", "restDaysUsed": 2, "daysPracticed": 5 }, "today": "2026-09-25", "pauses": [],
      "expect": { "current": 1, "best": 5, "lastActiveDate": "2026-09-25", "restDaysUsed": 0, "daysPracticed": 6, "outcome": "restarted", "restDaysBridged": 0, "milestone": null } },
    { "name": "Sunday belongs to the week that started on Monday", "state": { "current": 5, "best": 5, "lastActiveDate": "2026-09-26", "restDaysUsed": 2, "daysPracticed": 5 }, "today": "2026-09-29", "pauses": [],
      "expect": { "current": 1, "best": 5, "lastActiveDate": "2026-09-29", "restDaysUsed": 0, "daysPracticed": 6, "outcome": "restarted", "restDaysBridged": 0, "milestone": null } },
    { "name": "a new week brings two new rest days", "state": { "current": 5, "best": 5, "lastActiveDate": "2026-09-27", "restDaysUsed": 2, "daysPracticed": 5 }, "today": "2026-09-30", "pauses": [],
      "expect": { "current": 6, "best": 6, "lastActiveDate": "2026-09-30", "restDaysUsed": 2, "daysPracticed": 6, "outcome": "bridged", "restDaysBridged": 2, "milestone": null } },
    { "name": "practising on Monday after a full week leaves the new week untouched", "state": { "current": 5, "best": 5, "lastActiveDate": "2026-09-27", "restDaysUsed": 2, "daysPracticed": 5 }, "today": "2026-09-28", "pauses": [],
      "expect": { "current": 6, "best": 6, "lastActiveDate": "2026-09-28", "restDaysUsed": 0, "daysPracticed": 6, "outcome": "extended", "restDaysBridged": 0, "milestone": null } },
    { "name": "a gap longer than a week rests the run", "state": { "current": 8, "best": 8, "lastActiveDate": "2026-09-21", "restDaysUsed": 0, "daysPracticed": 8 }, "today": "2026-10-05", "pauses": [],
      "expect": { "current": 1, "best": 8, "lastActiveDate": "2026-10-05", "restDaysUsed": 0, "daysPracticed": 9, "outcome": "restarted", "restDaysBridged": 0, "milestone": null } },
    { "name": "a holiday pause covers the whole gap", "state": { "current": 8, "best": 8, "lastActiveDate": "2026-09-21", "restDaysUsed": 0, "daysPracticed": 8 }, "today": "2026-10-01", "pauses": [{ "startsOn": "2026-09-22", "endsOn": "2026-09-30" }],
      "expect": { "current": 9, "best": 9, "lastActiveDate": "2026-10-01", "restDaysUsed": 0, "daysPracticed": 9, "outcome": "extended", "restDaysBridged": 0, "milestone": null } },
    { "name": "paused days are not rest days", "state": { "current": 2, "best": 2, "lastActiveDate": "2026-09-21", "restDaysUsed": 0, "daysPracticed": 2 }, "today": "2026-09-26", "pauses": [{ "startsOn": "2026-09-23", "endsOn": "2026-09-24" }],
      "expect": { "current": 3, "best": 3, "lastActiveDate": "2026-09-26", "restDaysUsed": 2, "daysPracticed": 3, "outcome": "bridged", "restDaysBridged": 2, "milestone": null } },
    { "name": "day seven is a milestone", "state": { "current": 6, "best": 6, "lastActiveDate": "2026-09-23", "restDaysUsed": 0, "daysPracticed": 20 }, "today": "2026-09-24", "pauses": [],
      "expect": { "current": 7, "best": 7, "lastActiveDate": "2026-09-24", "restDaysUsed": 0, "daysPracticed": 21, "outcome": "extended", "restDaysBridged": 0, "milestone": 7 } },
    { "name": "a milestone reached after a rest day still counts", "state": { "current": 29, "best": 29, "lastActiveDate": "2026-09-22", "restDaysUsed": 0, "daysPracticed": 40 }, "today": "2026-09-24", "pauses": [],
      "expect": { "current": 30, "best": 30, "lastActiveDate": "2026-09-24", "restDaysUsed": 1, "daysPracticed": 41, "outcome": "bridged", "restDaysBridged": 1, "milestone": 30 } },
    { "name": "day one hundred is a milestone", "state": { "current": 99, "best": 99, "lastActiveDate": "2026-09-23", "restDaysUsed": 0, "daysPracticed": 130 }, "today": "2026-09-24", "pauses": [],
      "expect": { "current": 100, "best": 100, "lastActiveDate": "2026-09-24", "restDaysUsed": 0, "daysPracticed": 131, "outcome": "extended", "restDaysBridged": 0, "milestone": 100 } },
    { "name": "day eight is an ordinary day", "state": { "current": 7, "best": 7, "lastActiveDate": "2026-09-23", "restDaysUsed": 0, "daysPracticed": 7 }, "today": "2026-09-24", "pauses": [],
      "expect": { "current": 8, "best": 8, "lastActiveDate": "2026-09-24", "restDaysUsed": 0, "daysPracticed": 8, "outcome": "extended", "restDaysBridged": 0, "milestone": null } },
    { "name": "reaching seven again in a new run is a milestone again", "state": { "current": 6, "best": 40, "lastActiveDate": "2026-09-23", "restDaysUsed": 0, "daysPracticed": 90 }, "today": "2026-09-24", "pauses": [],
      "expect": { "current": 7, "best": 40, "lastActiveDate": "2026-09-24", "restDaysUsed": 0, "daysPracticed": 91, "outcome": "extended", "restDaysBridged": 0, "milestone": 7 } },
    { "name": "an earlier device date changes nothing", "state": { "current": 4, "best": 6, "lastActiveDate": "2026-09-24", "restDaysUsed": 1, "daysPracticed": 12 }, "today": "2026-09-23", "pauses": [],
      "expect": { "current": 4, "best": 6, "lastActiveDate": "2026-09-24", "restDaysUsed": 1, "daysPracticed": 12, "outcome": "earlier_date", "restDaysBridged": 0, "milestone": null } },
    { "name": "a restart never lowers the best", "state": { "current": 12, "best": 12, "lastActiveDate": "2026-09-14", "restDaysUsed": 0, "daysPracticed": 30 }, "today": "2026-09-24", "pauses": [],
      "expect": { "current": 1, "best": 12, "lastActiveDate": "2026-09-24", "restDaysUsed": 0, "daysPracticed": 31, "outcome": "restarted", "restDaysBridged": 0, "milestone": null } },
    { "name": "year boundary, next day", "state": { "current": 9, "best": 9, "lastActiveDate": "2025-12-31", "restDaysUsed": 0, "daysPracticed": 9 }, "today": "2026-01-01", "pauses": [],
      "expect": { "current": 10, "best": 10, "lastActiveDate": "2026-01-01", "restDaysUsed": 0, "daysPracticed": 10, "outcome": "extended", "restDaysBridged": 0, "milestone": null } },
    { "name": "year boundary, the ISO week spans both years", "state": { "current": 9, "best": 9, "lastActiveDate": "2025-12-30", "restDaysUsed": 0, "daysPracticed": 9 }, "today": "2026-01-02", "pauses": [],
      "expect": { "current": 10, "best": 10, "lastActiveDate": "2026-01-02", "restDaysUsed": 2, "daysPracticed": 10, "outcome": "bridged", "restDaysBridged": 2, "milestone": null } },
    { "name": "a legacy row whose best is below its current is repaired upward", "state": { "current": 5, "best": 0, "lastActiveDate": "2026-09-23", "restDaysUsed": 0, "daysPracticed": 0 }, "today": "2026-09-24", "pauses": [],
      "expect": { "current": 6, "best": 6, "lastActiveDate": "2026-09-24", "restDaysUsed": 0, "daysPracticed": 1, "outcome": "extended", "restDaysBridged": 0, "milestone": null } }
  ],
  "read": [
    { "name": "nothing practised yet", "state": { "current": 0, "best": 0, "lastActiveDate": null, "restDaysUsed": 0, "daysPracticed": 0 }, "today": "2026-09-24", "pauses": [],
      "expect": { "status": "none", "current": 0, "best": 0, "restDaysLeft": 2 } },
    { "name": "practised today", "state": { "current": 4, "best": 9, "lastActiveDate": "2026-09-24", "restDaysUsed": 1, "daysPracticed": 30 }, "today": "2026-09-24", "pauses": [],
      "expect": { "status": "practiced_today", "current": 4, "best": 9, "restDaysLeft": 1 } },
    { "name": "open, practised yesterday", "state": { "current": 4, "best": 9, "lastActiveDate": "2026-09-23", "restDaysUsed": 0, "daysPracticed": 30 }, "today": "2026-09-24", "pauses": [],
      "expect": { "status": "open", "current": 4, "best": 9, "restDaysLeft": 2 } },
    { "name": "open, one rest day already taken", "state": { "current": 4, "best": 9, "lastActiveDate": "2026-09-22", "restDaysUsed": 0, "daysPracticed": 30 }, "today": "2026-09-24", "pauses": [],
      "expect": { "status": "open", "current": 4, "best": 9, "restDaysLeft": 1 } },
    { "name": "resting after three missed days", "state": { "current": 4, "best": 9, "lastActiveDate": "2026-09-21", "restDaysUsed": 0, "daysPracticed": 30 }, "today": "2026-09-25", "pauses": [],
      "expect": { "status": "resting", "current": 0, "best": 9, "restDaysLeft": 2 } },
    { "name": "paused today by a guardian", "state": { "current": 4, "best": 9, "lastActiveDate": "2026-09-21", "restDaysUsed": 0, "daysPracticed": 30 }, "today": "2026-09-25", "pauses": [{ "startsOn": "2026-09-22", "endsOn": "2026-09-30" }],
      "expect": { "status": "paused", "current": 4, "best": 9, "restDaysLeft": 2 } },
    { "name": "a new week, rest days renewed", "state": { "current": 6, "best": 9, "lastActiveDate": "2026-09-27", "restDaysUsed": 2, "daysPracticed": 30 }, "today": "2026-09-28", "pauses": [],
      "expect": { "status": "open", "current": 6, "best": 9, "restDaysLeft": 2 } }
  ]
}
