# Pulse (observability stack) — Railway variable contract, per service.
# Placeholders only; real values live exclusively in Railway. Never track
# secrets (/AGENTS.md §1.10). Generate secrets with: openssl rand -base64 48
#
# ── pulse-db (PostgreSQL 16) ─────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres
# REQUIRED on Railway: initdb refuses the volume mount point itself (it
# contains lost+found); PGDATA must point one level below it.
PGDATA=/var/lib/postgresql/data/pgdata
# Consumed by init-scripts/00-create-databases.sh on FIRST boot only:
PLAUSIBLE_DB_PASSWORD=change-me
UMAMI_DB_PASSWORD=change-me

# ── pulse-clickhouse ─────────────────────────────────────────────────────
# No env needed — config baked into the image (config.d/users.d overlays).

# ── pulse-plausible (Plausible CE) ───────────────────────────────────────
# REQUIRED on Railway: image USER is 999 but the volume mounts root-owned;
# the seed-volume entrypoint needs root to restore image data + TMPDIR
# (see railway/plausible/seed-volume-entrypoint.sh).
RAILWAY_RUN_UID=0
BASE_URL=https://pulse-plausible.example.up.railway.app
SECRET_KEY_BASE=change-me-64-bytes-base64
TOTP_VAULT_KEY=change-me-32-bytes-base64
DATABASE_URL=postgres://plausible:change-me@pulse-db.railway.internal:5432/plausible
CLICKHOUSE_DATABASE_URL=http://pulse-clickhouse.railway.internal:8123/plausible_events_db
# Invite-only after the first admin account exists (set post-bootstrap):
DISABLE_REGISTRATION=invite_only
# Transactional email via Courier's SES relay (same infra as email-server/):
MAILER_ADAPTER=Bamboo.SMTPAdapter
SMTP_HOST_ADDR=email-smtp.us-east-1.amazonaws.com
SMTP_HOST_PORT=587
SMTP_USER_NAME=change-me
SMTP_USER_PWD=change-me
MAILER_EMAIL=pulse@littlefounders.ai
# GA4 historical import (bring-your-own Google Cloud OAuth app — see
# pulse/README.md § "GA4 import"). Redirect URL: BASE_URL/auth/google/callback
GOOGLE_CLIENT_ID=change-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=change-me

# ── pulse-umami (Umami v3) ───────────────────────────────────────────────
DATABASE_URL=postgresql://umami:change-me@pulse-db.railway.internal:5432/umami
APP_SECRET=change-me-random-string
# REQUIRED: Railway injects PORT=8080 by default and it wins over the
# Dockerfile ENV — pin it so the app binds the port Core/Kuma probe.
PORT=3000

# ── pulse-kuma (Uptime Kuma) ─────────────────────────────────────────────
# REQUIRED: same Railway PORT-injection caveat as Umami — pin it or Core's
# KUMA_URL (:3001) can't reach it.
PORT=3001
# Everything else is configured through Kuma's own UI (volume-persisted
# SQLite). Admin account: strong password + 2FA, created on first visit.
