{
  "name": "littlefounders",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "setup": "bash scripts/setup-dev.sh",
    "dev": "bash scripts/start-dev.sh",
    "repo:map": "bash scripts/update-repo-map.sh",
    "docs:check": "bash agent/tools/check-docs-sync.sh",
    "secrets:check": "bash agent/tools/check-secrets.sh",
    "i18n:check": "bash agent/tools/check-i18n.sh",
    "paths:check": "node agent/tools/check-marketing-paths.mjs",
    "provider:check": "node agent/tools/check-provider-parity.mjs",
    "deps:check": "bash agent/tools/check-dep-drift.sh",
    "git:diff-check": "bash agent/tools/check-clean-tree.sh",
    "release:readiness": "bash agent/tools/release-readiness.sh",
    "production:preflight": "bash agent/tools/railway-preflight.sh",
    "production:preflight:test": "node agent/tools/railway-preflight.test.mjs",
    "tools:test": "node --test agent/tools/*.test.mjs",
    "test:all": "bash agent/tools/run-all.sh test",
    "typecheck:all": "bash agent/tools/run-all.sh type-check",
    "lint:all": "bash agent/tools/run-all.sh lint",
    "legal:sync": "node agent/tools/sync-legal-i18n.mjs"
  }
}
