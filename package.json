{
  "name": "littlefounders",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "setup": "bash scripts/setup-dev.sh",
    "dev": "bash scripts/start-dev.sh",
    "secrets:check": "bash agent/tools/check-secrets.sh",
    "i18n:check": "bash agent/tools/check-i18n.sh",
    "paths:check": "node agent/tools/check-marketing-paths.mjs",
    "seo:check": "node agent/tools/check-seo-surface.mjs",
    "seo:live": "node agent/tools/check-seo-live.mjs",
    "seo:indexnow": "node frontend/scripts/seo/indexnow.mjs",
    "provider:check": "node agent/tools/check-provider-parity.mjs",
    "instruments:check": "node agent/tools/check-instrument-parity.mjs",
    "preferred-types:check": "node agent/tools/check-preferred-types-parity.mjs",
    "demo-step:check": "node agent/tools/check-demo-step-parity.mjs",
    "roleplay-voices:check": "node agent/tools/check-roleplay-voice-parity.mjs",
    "roleplay-voices:generate": "node agent/tools/generate-roleplay-voices.mjs",
    "narration:check": "node agent/tools/check-narration-parity.mjs",
    "content:gates": "npm --prefix coursegen run content:gates --",
    "forge:release-gates:check": "node agent/tools/check-forge-release-gate-parity.mjs",
    "forge:v2:dry-run": "npm --prefix coursegen run v2:emit -- --out runs/v2-emit/latest && npm --prefix backend run forge-v2:check -- ../coursegen/runs/v2-emit/latest/documents.json",
    "deps:check": "bash agent/tools/check-dep-drift.sh",
    "git:diff-check": "bash agent/tools/check-clean-tree.sh",
    "release:readiness": "bash agent/tools/release-readiness.sh",
    "production:preflight": "bash agent/tools/railway-preflight.sh",
    "production:preflight:test": "node agent/tools/railway-preflight.test.mjs",
    "sharing:check": "node agent/tools/check-achievement-sharing.mjs",
    "deletion:check": "node agent/tools/check-account-deletion.mjs",
    "social:check": "node agent/tools/check-social-tiers.mjs",
    "guardrails:check": "node agent/tools/check-social-governance.mjs",
    "tools:test": "node --test agent/tools/*.test.mjs",
    "test:all": "bash agent/tools/run-all.sh test",
    "typecheck:all": "bash agent/tools/run-all.sh type-check",
    "lint:all": "bash agent/tools/run-all.sh lint",
    "spec:check": "node agent/tools/check-product-spec.mjs && node agent/tools/check-achievement-sharing.mjs && node agent/tools/check-account-deletion.mjs && node agent/tools/check-social-tiers.mjs && node agent/tools/check-social-governance.mjs && node agent/tools/sync-v2-visual-scorer.mjs --check && node agent/tools/sync-v2-growth-comparison.mjs --check && node agent/tools/sync-v2-tax-bracket.mjs --check && node agent/tools/check-v2-lesson-capability-parity.mjs && node frontend/scripts/build-rebuild-tokens.mjs --check && node frontend/scripts/check-rebuild-assets.mjs && node frontend/scripts/build-rebuild-emails.mjs --check"
  }
}
