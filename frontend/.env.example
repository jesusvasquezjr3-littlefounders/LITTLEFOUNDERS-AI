# Core (backend) — the ONLY service the frontend calls (/AGENTS.md §1.5)
VITE_BACKEND_URL=http://localhost:4000

# Supabase (Vault) — for admin Realtime subscriptions only (generation_runs_live CDC).
# The browser connects to Supabase Realtime directly for this one table (0019 RLS
# policy — admin/superadmin only, zero PII). Everything else goes through Core.
# Local dev is the self-hosted docker compose stack (database/), whose Kong
# gateway listens on 8000 — NOT the Supabase CLI's `supabase start` default of
# 54321, which this project deliberately does not use (database/scripts/local-stack.sh).
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_ANON_KEY=replace-me

# Pulse trackers (ALL OPTIONAL — unset = no tracking, e.g. local dev).
# The ONLY browser-facing Pulse surfaces (§1.5 exception). Umami is §1.9-
# fenced in src/lib/analytics.tsx: never on kid sessions / kid surfaces.
#
# VITE_PLAUSIBLE_SRC is the per-site "new format" script URL from Plausible's
# Script installation screen (.../js/pa-<id>.js). It is PUBLIC (embedded on
# every page), not a secret; the site domain is baked into the hashed file so
# there is no separate domain var. Our SPA injects it — do NOT paste the
# snippet into index.html.
VITE_PLAUSIBLE_SRC=https://pulse-plausible-production.up.railway.app/js/pa-5KxZVE6i4MwvUHJhzq7VU.js
VITE_UMAMI_SRC=https://pulse-umami-production.up.railway.app/script.js
VITE_UMAMI_WEBSITE_ID=replace-me

# GA4 dual-tracking — PUBLIC MARKETING PAGES ONLY, never app/kid (§1.9). The
# measurement id (G-XXXX) is PUBLIC, not a secret. Unlike Plausible/Umami, GA4
# uses cookies; the src/lib/analytics.tsx gate keeps it off every app/kid path.
# Unset = GA4 off. See WALKTHROUGH.md (cookie-consent follow-up).
VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Tutor 3D scene assets (OPTIONAL — unset = served by Vite from public/scenes,
# which is what local dev wants).
#
# Set it to Depot's public download base for the bucket. Depot is CONTENT
# ADDRESSED — /files/:bucket/:hash.:ext, "independent of the uploader's original
# filename" — so this variable ALONE is not enough: the build also needs
# src/tutor-scene/sceneManifest.generated.json, which maps each asset's logical
# name to the hash Depot serves it under. Publish first, commit the manifest,
# then set this. See /TUTOR_3D.md §3.2.
#
#   npm run publish:scenes    (needs FILEBASE_URL + INTERNAL_API_KEY)
#
# VITE_SCENE_ASSET_BASE=https://<depot-host>/files/tutor-scenes
