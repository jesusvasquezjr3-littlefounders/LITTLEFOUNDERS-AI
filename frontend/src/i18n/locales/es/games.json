  "gameDescriptions": {
    "namVsYum": {
      "summary": "Un festín monstruoso donde los niños aprenden a diferenciar entre necesidades y caprichos.",
      "teaches": "Educación financiera básica, toma de decisiones, priorización de gastos",
      "ageGroup": "ages5to7"
    },
    "nectar": {
      "summary": "Dirige tu propio puesto de néctar en un reino subterráneo mientras aprendes sobre costos y ganancias.",
      "teaches": "Emprendimiento, cálculo de costos, fijación de precios, ahorro",
      "ageGroup": "ages5to7"
    },
    "paperDetective": {
      "summary": "Resuelve misterios financieros identificando monedas y ahorrando en una alcancía.",
      "teaches": "Reconocimiento de monedas, conteo de dinero, metas de ahorro",
      "ageGroup": "ages5to7"
    },
    "paperCoin": {
      "summary": "Atiende una tienda de aventureros calculando el cambio correcto bajo presión.",
      "teaches": "Cálculo mental, manejo de dinero, atención al cliente, rapidez mental",
      "ageGroup": "ages8to9"
    },
    "hackerDefense": {
      "summary": "Defiende tu cuenta bancaria de ciberataques construyendo torres y detectando amenazas en tiempo real.",
      "teaches": "Ciberseguridad, reconocimiento de phishing, contraseñas seguras, autenticación en dos pasos",
      "ageGroup": "ages10to12"
    },
    "chronoBloom": {
      "summary": "Planta semillas financieras en una cuadrícula, avanza el tiempo y observa cómo el interés compuesto multiplica tus ahorros mientras defiendes tu invernadero.",
      "teaches": "Interés compuesto, gratificación diferida, costo de oportunidad, diversificación, inflación",
      "ageGroup": "ages8to9"
    }
  },
