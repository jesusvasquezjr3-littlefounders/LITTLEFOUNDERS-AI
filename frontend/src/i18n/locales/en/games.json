  "gameDescriptions": {
    "namVsYum": {
      "summary": "A monstrous feast where children learn to differentiate between needs and wants.",
      "teaches": "Basic financial education, decision making, expense prioritization",
      "ageGroup": "ages5to7"
    },
    "nectar": {
      "summary": "Run your own nectar stand in an underground kingdom while learning about costs and profits.",
      "teaches": "Entrepreneurship, cost calculation, pricing, saving",
      "ageGroup": "ages5to7"
    },
    "paperDetective": {
      "summary": "Solve financial mysteries by identifying coins and saving in a piggy bank.",
      "teaches": "Coin recognition, money counting, savings goals",
      "ageGroup": "ages5to7"
    },
    "paperCoin": {
      "summary": "Run an adventurer's shop by calculating the correct change under pressure.",
      "teaches": "Mental math, money handling, customer service, quick thinking",
      "ageGroup": "ages8to9"
    },
    "hackerDefense": {
      "summary": "Defend your bank account from cyberattacks by building towers and detecting threats in real time.",
      "teaches": "Cybersecurity, phishing detection, strong passwords, two-factor authentication",
      "ageGroup": "ages10to12"
    },
    "chronoBloom": {
      "summary": "Plant financial seeds on a grid, advance time, and watch compound interest multiply your savings while defending your greenhouse from financial threats.",
      "teaches": "Compound interest, delayed gratification, opportunity cost, diversification, inflation",
      "ageGroup": "ages8to9"
    }
  },
