PORT=4008

# Service-to-service auth — validates inbound x-internal-api-key
INTERNAL_API_KEY=replace-me

# Vault (Supabase self-hosted on Railway) — read-only data source. Local dev
# is the self-hosted docker compose stack (database/), whose Kong gateway
# listens on 8000 — NOT the Supabase CLI's `supabase start` default of 54321,
# which this project deliberately does not use (database/scripts/local-stack.sh).
SUPABASE_URL=http://localhost:8000
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Redis for dashboard query cache
REDIS_URL=redis://localhost:6379

# DuckDB database file path
DUCKDB_PATH=./duckdb/dataintel.db

# Sync interval in milliseconds (default 5 minutes)
SYNC_INTERVAL_MS=300000
