# Only the exact words `development` and `test` relax anything. Left out or
# misspelled, the service runs as production: the key is required and the
# default engine is haraka.
NODE_ENV=development

PORT=4005

# Which engine boots (src/config.ts). Defaults to 'haraka' in production and
# 'noop' otherwise, so `npm run dev` and `npm test` need no smarthost credentials.
#   noop   — logs and reports queued; nothing leaves the box.
#   smtp   — submits to SMTP_HOST:SMTP_PORT and no further: the local mail
#            catcher of database/scripts/local-stack.sh, to read the emails.
#   haraka — boots the Haraka SMTP engine in haraka/ and relays to the smarthost.
EMAIL_ENGINE=noop

# Envelope/header From of every email.
MAIL_FROM=LittleFounders <noreply@littlefounders.ai>

# The site's own address: the emails take their images and typeface from it
# and link to it. Default https://littlefounders.ai. Local: the dev server.
FRONTEND_URL=http://localhost:5173

# Engine 'smtp' only.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025

# Haraka: where the co-located HTTP adapter submits mail (the only listener,
# localhost: haraka/config/smtp.ini), and the hostname Haraka announces in HELO.
HARAKA_LOCAL_HOST=127.0.0.1
HARAKA_LOCAL_PORT=2525
HARAKA_HOSTNAME=email-server.railway.internal

# SMTP smarthost: the relay every email leaves through (Brevo's, smtp-relay.brevo.com,
# since 2026-10-12). REQUIRED when EMAIL_ENGINE=haraka (boot throws without them). The
# user and the password are the relay's own SMTP login and SMTP key, not an account login.
SMTP_RELAY_HOST=replace-me
SMTP_RELAY_PORT=587
SMTP_RELAY_USER=replace-me
SMTP_RELAY_PASS=replace-me

# Service-to-service. Has no default in production: a missing key crashes
# boot rather than silently serving /api/v1 unauthenticated.
INTERNAL_API_KEY=replace-me

# Vault — the DURABLE delivery history (the email_logs table, database/migrations/0002_email.sql).
# OPTIONAL: without these Courier still sends mail and still serves
# /api/v1/logs, but only from the in-process ring buffer, which is wiped by
# every restart. Set them in production or the history is lost on restart.
#
# MAIL_SERVICE_KEY is this service's own key (database role `mail_service`:
# the delivery history and nothing else). Local: `npm run db:up` in database/
# generates it in database/supabase/docker/.env. Production: mint it with
# database/scripts/mint-role-key.mjs and set the same value on the gateway.
# Never put the service key (SUPABASE_SERVICE_ROLE_KEY) in this service.
SUPABASE_URL=http://localhost:8000
MAIL_SERVICE_KEY=replace-me
