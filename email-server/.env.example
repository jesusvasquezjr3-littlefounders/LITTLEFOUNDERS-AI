PORT=4005

# Which engine boots (src/config.ts). Defaults to 'haraka' in production and
# 'noop' otherwise, so `npm run dev` and `npm test` need no SES credentials.
#   noop   — logs and reports queued; nothing leaves the box.
#   haraka — boots the Haraka SMTP engine in haraka/ and relays to Amazon SES.
EMAIL_ENGINE=noop

# Envelope/header From for our own transactional mail (GoTrue sets its own).
MAIL_FROM=LittleFounders <noreply@littlefounders.ai>

# Haraka: where the co-located HTTP adapter submits mail, and the hostname
# Haraka announces in HELO. The private submission port (587) lives in
# haraka/config/smtp.ini.
HARAKA_LOCAL_HOST=127.0.0.1
HARAKA_LOCAL_PORT=2525
HARAKA_HOSTNAME=email-server.railway.internal

# Amazon SES SMTP smarthost — the last-mile relay. REQUIRED when
# EMAIL_ENGINE=haraka (boot throws without them). These are region-scoped
# SES SMTP credentials, NOT AWS access keys.
SES_RELAY_HOST=replace-me
SES_RELAY_PORT=587
SES_SMTP_USER=replace-me
SES_SMTP_PASS=replace-me

# Service-to-service. Has no default in production: a missing key crashes
# boot rather than silently serving /api/v1 unauthenticated.
INTERNAL_API_KEY=replace-me
