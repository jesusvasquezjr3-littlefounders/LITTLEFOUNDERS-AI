# Local env
.env
.env.*
!.env.example

# Haraka runtime artifacts + rendered-at-boot config that carries SES secrets.
# These are generated by src/services/haraka.ts at boot — never commit them.
haraka/config/me
haraka/config/smtp_forward.ini
haraka/config/tls_key.pem
haraka/config/tls_cert.pem
haraka/queue/
haraka/*.pid
