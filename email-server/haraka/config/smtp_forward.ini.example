; TEMPLATE ONLY. The real config/smtp_forward.ini is RENDERED AT BOOT by
; src/index.ts from environment variables (see email-server/.env.example) and is
; git-ignored because it holds the smarthost's SMTP credentials. Never hand-edit
; or commit the rendered file. This .example documents the shape it takes.

; SMTP smarthost. Every relaying (internal) message is forwarded here
; instead of delivered direct-to-MX: Railway blocks outbound port 25, and the
; smarthost owns the sending reputation that keeps sign-in mail out of spam.
host=smtp-relay.brevo.com
port=587
enable_tls=true

; SMTP AUTH to the smarthost: its own SMTP login and SMTP key, not an account login.
auth_type=plain
auth_user=__SMTP_RELAY_USER__
auth_pass=__SMTP_RELAY_PASS__

; Deliver outbound (relaying) mail via this smarthost. Registers the
; queue_outbound hook — see node_modules/Haraka/config/smtp_forward.ini.
enable_outbound=true

; The smarthost's certificate is verified, and plugins/forward_secure.js sends
; nothing when the connection is not encrypted.
[tls]
rejectUnauthorized=true
