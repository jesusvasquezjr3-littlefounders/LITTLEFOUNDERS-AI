# ============================================================
# audio_factory — Variables de entorno
# Copia este archivo como .env y rellena los valores reales
# ============================================================

# Alibaba Cloud DashScope (Qwen TTS + Voice Cloning)
DASHSCOPE_API_KEY=sk-...

# DeepSeek (extracción inteligente de texto por target_field)
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Backend local o remoto (para leer datos de lección via REST)
BACKEND_URL=http://localhost:8000

# Supabase (para subir audios al bucket y registrar en DB)
SUPABASE_URL=https://xxpsyormxalqjcbomiwe.supabase.co
SUPABASE_SERVICE_KEY=eyJ...   # service_role key (NO la anon key)

# Bucket de Supabase donde se guardan los assets
SUPABASE_BUCKET=game-assets
