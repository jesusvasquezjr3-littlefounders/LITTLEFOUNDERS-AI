# Deployment isolation + upload hygiene for `railway up backend --path-as-root`.
# Read relative to THIS service dir (path-as-root re-roots the archive here,
# so the repo-root .gitignore's path-prefixed rules do NOT apply — every
# service carries its own ignore). Nixpacks reinstalls deps (`npm ci`) and
# rebuilds (`npm run build`), so the uploaded archive needs only source +
# manifests, nothing generated or secret.
node_modules/
dist/
coverage/
*.log
.env
.env.*
!.env.example
.DS_Store
