PORT=4000
FRONTEND_URL=http://localhost:5173

# Supabase self-hosted stack (local: Kong on :8000 — see database/README.md;
# values come from database/supabase/docker/.env, generated per machine)
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_JWT_SECRET=replace-me

# Service-to-service auth (shared with internal services)
INTERNAL_API_KEY=replace-me

# Internal service URLs
# Production defaults to the Railway private domain when this is omitted.
COURSEGEN_URL=http://localhost:4001
AUDIOGEN_URL=http://localhost:4002
PARENT_ID_CHECK_URL=http://localhost:4004
EMAIL_SERVER_URL=http://localhost:4005

# Pulse (observability) — ALL OPTIONAL: Core boots and serves the product
# without them; /api/v1/admin/* answers 503 PULSE_UNCONFIGURED instead.
# In production these point at Railway private networking (pulse/README.md).
PLAUSIBLE_URL=http://pulse-plausible.railway.internal:8000
PLAUSIBLE_API_KEY=replace-me
PLAUSIBLE_SITE_ID=littlefounders.ai
# The timezone the Plausible SITE is set to — not the server's. Every analytics
# window is resolved in it, because Plausible evaluates dates in it. Optional;
# defaults to America/Mexico_City (verified against production 2026-08-27).
PLAUSIBLE_SITE_TIMEZONE=America/Mexico_City
UMAMI_URL=http://pulse-umami.railway.internal:3000
UMAMI_USERNAME=replace-me
UMAMI_PASSWORD=replace-me
UMAMI_WEBSITE_ID=replace-me
KUMA_URL=http://pulse-kuma.railway.internal:3001
KUMA_STATUS_SLUG=pulse

# dataintel analytics proxy
DATAINTEL_URL=http://localhost:4008
DATAINTEL_INTERNAL_KEY=replace-me-0123456789
DATAINTEL_TIMEOUT_MS=30000

# Depot (filebase) — lesson/tutor media. Writes are internal-key only.
FILEBASE_URL=http://localhost:4006
FILEBASE_INTERNAL_KEY=replace-me-0123456789

# Oracle — the AI Tutor runtime (/ORACLE.md).
#
# TWO URLs, and the distinction is load-bearing. ORACLE_URL is where CORE calls
# Oracle, server to server, over Railway private networking. ORACLE_PUBLIC_URL
# is the address Core hands the BROWSER so it can open the one direct websocket
# the §1.5 exception permits. Setting them to the same value works locally and
# is wrong in production.
ORACLE_URL=http://localhost:4009
ORACLE_PUBLIC_URL=http://localhost:4009
ORACLE_INTERNAL_KEY=replace-me-0123456789
ORACLE_TIMEOUT_MS=8000

# Signs the single-use, session-scoped token the browser carries to Oracle
# (/ORACLE.md §3.2). MUST be byte-identical to oracle/TUTOR_SESSION_SECRET —
# Core mints, Oracle verifies — and MUST differ from every other secret here.
# Minimum 32 characters. REQUIRED — Core refuses to boot without it, the same
# way oracle's own copy already does, because a mismatch here breaks every
# Tutor session's websocket handshake silently (round 58, 2026-08-30).
TUTOR_SESSION_SECRET=replace-me-with-a-64-char-random-string-0000

# Signs the short-lived, one-use browser tokens for v2 lesson segments. This
# must be a separately generated secret (minimum 32 characters), never the
# Tutor, JWT or internal-service secret. Until an operator sets it, v2 runs
# intentionally return unavailable while the established v1 product remains up.
LESSON_ATTEMPT_SECRET=replace-me-with-a-separate-64-char-random-string-0000

# Fraction of live-generated tutor segments queued for post-hoc human review
# (/ORACLE.md §7.3). 0.15 = one in seven. A compensating control for the §1.9
# carve-out, so lowering it is a decision, not a tuning knob.
TUTOR_LIVE_REVIEW_SAMPLE_RATE=0.15
# C.5 / Appendix E §3.1.1: the baseline for content flagged as touching a
# sensitive topic (financial hardship, family conflict, loss, safety-adjacent).
# Both values are FLOORED in code (15% standard, 50% sensitive): a lower value
# is ignored. Staff-found issues raise the rate further, automatically.
TUTOR_LIVE_REVIEW_SENSITIVE_SAMPLE_RATE=0.5

# The Tutor v3 pedagogical brain (KC graph + BKT + FSRS + session plan,
# migration 0052). Degrades gracefully while 0052 is unapplied/unseeded; set
# to `false` only to turn the brain off deliberately.
TUTOR_V3_BRAIN=true

# B.6 course engine (S05.3b). `linear` = the legacy flat lesson order (default).
# `pathway` = the age-pathway frontier on the Mentor's knowledge graph
# (docs/rebuild/sprints/S05-B6-PATHWAY-POLICY.md). Switch it on only after the
# owner accepts the policy (OD-22) and the B.6 migrations are applied and seeded.
COURSE_PATHWAY_ENGINE=linear

# Owner review P-09: a graded course lesson feeds the Mentor's mastery model
# (kc_attempt source 'course_lesson') only when the engine above is `pathway`
# AND this calibration switch is `on`. Keep `off` until the calibration row in
# docs/rebuild/mentor/THRESHOLD-RECALIBRATION-LOG.md has passed.
COURSE_LESSON_EVIDENCE=off

# C.11: the cross-session scheduler's short horizon in minutes — an attempt
# this soon after the memory card's last counted review is a within-session
# re-exposure (no stability growth). 0 restores the pre-C.11 scheduler.
TUTOR_REVIEW_SHORT_HORIZON_MIN=180
# C.17: dialogue bands the A/B experiment may enrol. OD-26 opens C.17 to teens
# (own analytics opt-in) and tweens 10-12 (guardian analytics consent);
# young_child is never accepted (npm run review-calibration:check refuses a
# default that enrols it). Narrow to `adult` to keep minors out.
MENTOR_DIALOGUE_EXPERIMENT_BANDS=adult,teen,tween

# Redis — rate limiting. Degrades open; never fatal (§1.14).
REDIS_URL=redis://localhost:6379
