# Configuración de Base de Datos PostgreSQL para Google Cloud Platform (GCP)
DATABASE_URL=postgresql://username:password@ip_publica:5432/database_name

# Ejemplo para Google Cloud SQL:
# DATABASE_URL=postgresql://littlefounders_user:tu_contraseña_segura@35.XXX.XXX.XXX:5432/littlefounders_db

# Para desarrollo local:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/littlefounders_dev

# Configuración JWT (para futuras implementaciones)
SECRET_KEY=tu_clave_secreta_muy_larga_y_segura_aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Configuración de archivos
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880  # 5MB en bytes