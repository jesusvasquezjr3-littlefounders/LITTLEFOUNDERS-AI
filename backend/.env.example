# ── Runtime ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8000

# ── Database (Supabase PostgreSQL) ──────────────────────────────────
DATABASE_HOSTNAME=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=littlefounders

# ── Security ─────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Supabase ─────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# ── CORS (opcional — override comma-separated para Render) ───────────
# CORS_ORIGINS=https://littlefounders.ai,https://www.littlefounders.ai

# ── Email (opcional — SMTP) ──────────────────────────────────────────
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@littlefounders.ai
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME=LittleFounders
