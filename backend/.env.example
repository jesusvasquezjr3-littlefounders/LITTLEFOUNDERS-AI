# Core, the backend. The names below are the ones the production service
# `littlefounders-backend` already has on Railway: keep them, so the keys that
# work there keep working. Full catalog: docs/operations/ENVIRONMENT-SETUP.md.

PORT=4000

# The one browser origin allowed to call Core, and where a person lands after
# signing in. Production: https://littlefounders.ai
FRONTEND_URL=http://localhost:5173

# The Supabase gateway (Kong). Local values come from
# database/supabase/docker/.env (ANON_KEY, SERVICE_ROLE_KEY, JWT_SECRET),
# generated per machine by `npm run db:up` in database/.
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_JWT_SECRET=replace-me

# Counters for rate limits and code attempts. Required in production (Core does
# not boot without it there). Leave unset locally: counters are kept in memory.
# REDIS_URL=redis://localhost:6379

# The mail service (email-server/) and the key it expects. Production has both
# under these names already. Local: start email-server with EMAIL_ENGINE=smtp
# and the same key in its own .env.
EMAIL_SERVER_URL=http://localhost:4005
INTERNAL_API_KEY=replace-me

# --- New ---

# The secret the authentication service signs its "send email" hook with. The
# same value goes in its GOTRUE_HOOK_SEND_EMAIL_SECRETS. Required in production.
# Local: `npm run db:up` in database/ generates one and prints where it is.
SEND_EMAIL_HOOK_SECRET=replace-me

# --- New and optional (not set in production today) ---

# The address a browser reaches Core at, when it is not the frontend's own
# origin. Production: https://api-b2c.littlefounders.ai (the value the
# frontend already has in VITE_BACKEND_URL). Core then answers the frontend's
# cross-origin requests, and Google sign-in comes back to this address, which
# must be in the authentication service's GOTRUE_URI_ALLOW_LIST. Unset: the
# frontend's origin (a deployment where the frontend proxies /api to Core).
PUBLIC_API_ORIGIN=http://localhost:4000

# The issuer the authentication service writes into its tokens. Unset:
# SUPABASE_URL + /auth/v1 (the production value of GOTRUE_JWT_ISSUER).
# SUPABASE_JWT_ISSUER=

# Proxies between the visitor and Core, so the visitor's address is read
# correctly for rate limits. Default 1.
# TRUST_PROXY_HOPS=1
