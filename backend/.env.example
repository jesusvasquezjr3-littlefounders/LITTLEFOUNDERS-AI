PORT=4000
FRONTEND_URL=http://localhost:5173

# Supabase self-hosted stack (local: Kong on :8000 — see database/README.md;
# values come from database/supabase/docker/.env, generated per machine)
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_JWT_SECRET=replace-me

# Service-to-service auth (shared with internal services)
INTERNAL_API_KEY=replace-me

# Internal service URLs
COURSEGEN_URL=http://localhost:4001
AUDIOGEN_URL=http://localhost:4002
GAMEGEN_URL=http://localhost:4003
PARENT_ID_CHECK_URL=http://localhost:4004
EMAIL_SERVER_URL=http://localhost:4005

# Pulse (observability) — ALL OPTIONAL: Core boots and serves the product
# without them; /api/v1/admin/* answers 503 PULSE_UNCONFIGURED instead.
# In production these point at Railway private networking (pulse/README.md).
PLAUSIBLE_URL=http://pulse-plausible.railway.internal:8000
PLAUSIBLE_API_KEY=replace-me
PLAUSIBLE_SITE_ID=littlefounders.ai
# Read-only mirror of pulse-plausible's IP_BLOCKLIST (comma/whitespace separated)
# for the console's exclusions view — enforcement lives in Plausible's env.
PLAUSIBLE_IP_BLOCKLIST=
UMAMI_URL=http://pulse-umami.railway.internal:3000
UMAMI_USERNAME=replace-me
UMAMI_PASSWORD=replace-me
UMAMI_WEBSITE_ID=replace-me
KUMA_URL=http://pulse-kuma.railway.internal:3001
KUMA_STATUS_SLUG=pulse

# dataintel analytics proxy
DATAINTEL_URL=http://localhost:4008
DATAINTEL_INTERNAL_KEY=replace-me-0123456789
DATAINTEL_TIMEOUT_MS=30000
