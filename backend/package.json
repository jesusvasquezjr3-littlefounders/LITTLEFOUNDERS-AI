{
  "name": "@littlefounders/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "npm run contract:check && vitest run",
    "test:watch": "vitest",
    "contract:check": "npm run lesson-contract:check",
    "lesson-contract:check": "tsx scripts/contract-check.ts",
    "placement:verify": "tsx --env-file-if-exists=.env src/scripts/verify-placement.ts",
    "seed:kc": "tsx --env-file-if-exists=.env src/scripts/seed-kc-graph.ts",
    "audit:content-bridge": "tsx --env-file-if-exists=.env src/scripts/audit-content-bridge.ts",
    "curate:tutor-skills": "tsx --env-file-if-exists=.env src/scripts/curate-tutor-skills.ts"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "pdfkit": "^0.19.1",
    "rate-limit-redis": "^5.0.0",
    "redis": "^6.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.0",
    "eslint": "^9.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
