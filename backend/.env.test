# ── Test Environment ─────────────────────────────────────────────────
# Usar PostgreSQL local (no cloud) para tests
NODE_ENV=test
PORT=8000

DATABASE_HOSTNAME=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=littlefounders_test

SECRET_KEY=test-secret-key-at-least-32-characters-long-for-testing
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

SUPABASE_URL=http://localhost:54321
SUPABASE_KEY=test-anon-key

# Deshabilitar servicios externos en tests
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=587
MAIL_SERVER=
MAIL_FROM_NAME=
