# Oracle — the AI Tutor runtime (/ORACLE.md). Port 4009.
# Copy to .env for local development. NEVER commit a filled-in .env.

PORT=4009
NODE_ENV=development

# Service-to-service key for Oracle's own internal HTTP surface.
INTERNAL_API_KEY=replace-me-with-a-32-char-random-string

# Shared secret Core signs live-session tokens with (/ORACLE.md §3.2).
# MUST be different from INTERNAL_API_KEY: one authenticates a service, the
# other authenticates a single browser socket. Sharing them means a leaked
# session token can call the internal API.
TUTOR_SESSION_SECRET=replace-me-with-a-64-char-random-string

# Core — the only service that holds learner data. Oracle has no DB access.
CORE_URL=http://localhost:4000
CORE_INTERNAL_KEY=replace-me

# Depot — stores the TUTOR's synthesized audio. The learner's audio is never
# stored anywhere (/ORACLE.md §0 decision 8).
DEPOT_URL=http://localhost:4006
DEPOT_INTERNAL_KEY=replace-me

# Forge — tier-3 live segment generation (/ORACLE.md §7.3).
COURSEGEN_URL=http://localhost:4001
COURSEGEN_INTERNAL_KEY=replace-me

# The pedagogical model. Author = DeepSeek, judge = Qwen, same split as Forge.
# The base URL MUST carry /v1 — the endpoint is built by hand as
# ${MODEL_API_BASE}/chat/completions, so dropping it 404s every turn.
#
# FLASH, not PRO. deepseek-v4-pro is a reasoning model: it spends the whole
# completion budget on reasoning_content and returns empty content. Right for
# Forge, which authors offline; wrong here, where a learner is waiting.
MODEL_API_BASE=https://api.deepseek.com/v1
MODEL_API_KEY=
MODEL_NAME=deepseek-v4-flash
JUDGE_API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
JUDGE_API_KEY=
JUDGE_MODEL_NAME=qwen3-max

# Real-time voice. `none` is the DEFAULT and a fully supported posture: the
# session runs captioned and silent.
#
# The API surface WAS verified against the live service on 2026-08-21
# (`npm run voices:verify` re-runs that check). What is still outstanding is
# the data-processing agreement covering minors' audio — which is why the
# policy flag below exists separately from this key.
VOICE_PROVIDER=none
INWORLD_API_BASE=https://api.inworld.ai
# Inworld issues this ALREADY base64-encoded (`keyId:secret`). Do not re-encode.
INWORLD_API_KEY=
# Verified present: inworld-tts-1, inworld-tts-1-max, inworld-tts-2, inworld-tts-2-flash
INWORLD_TTS_MODEL=inworld-tts-1

# THE DPA GATE. While this is false, no minor's microphone opens — regardless
# of guardian consent, which is separate and also required. Adults are
# unaffected and every learner keeps the whole tutor; this gates one input
# method, not the product. Flipping it is an owner decision to record
# (/ORACLE.md §16, /LEGAL/AI_TUTOR_LEGAL_REVIEW.md §6).
TUTOR_VOICE_FOR_MINORS=false

# THE CHARACTER VOICES. The cast already has voices — Echo clones them per
# locale from the owner's reference recordings and narrates every lesson with
# them. The Tutor must use the SAME ones, or a child who knows Dr. Rho from a
# lesson meets a stranger. Populate with `npm run voices:clone -- --confirm`,
# which enrols from the same trimmed samples Echo uses.
#
# An UNSET character is SILENT in that locale — never a stock substitute.
INWORLD_VOICE_DINA_EN_US=
INWORLD_VOICE_DINA_ES_MX=
INWORLD_VOICE_DINA_PT_BR=
INWORLD_VOICE_LIRUF_EN_US=
INWORLD_VOICE_LIRUF_ES_MX=
INWORLD_VOICE_LIRUF_PT_BR=
INWORLD_VOICE_RHO_EN_US=
INWORLD_VOICE_RHO_ES_MX=
INWORLD_VOICE_RHO_PT_BR=
INWORLD_VOICE_ZARA_EN_US=
INWORLD_VOICE_ZARA_ES_MX=
INWORLD_VOICE_ZARA_PT_BR=

REDIS_URL=redis://localhost:6379

# Session budget (/ORACLE.md §9.5). HARD must exceed SOFT or startup fails.
SESSION_SOFT_BUDGET_MS=900000
SESSION_HARD_BUDGET_MS=1500000
SESSION_MAX_TURNS=120
TURN_MAX_INPUT_CHARS=600

MODEL_TIMEOUT_MS=20000
VOICE_TIMEOUT_MS=15000
CORE_TIMEOUT_MS=8000

# Fraction of live-generated segments queued for human review (/ORACLE.md §7.3).
LIVE_REVIEW_SAMPLE_RATE=0.15
