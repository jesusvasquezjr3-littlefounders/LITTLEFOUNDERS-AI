# oracle/.env.example — the reference configuration.
#
# THIS FILE IS EXPECTED TO PARSE AS-IS. Copy it to .env and the service boots:
# no model, no voice, captioned and text-only, which is a first-class supported
# posture (/ORACLE.md §14). It did not use to. Three internal keys carried
# 10-character values against `z.string().min(16)`, and every optional key was
# assigned an EMPTY value — and `.optional()` permits undefined, not '', so an
# empty assignment is a present value of length zero that fails its own `.min()`.
# Following the README quick start produced eighteen validation errors and a
# refusal to start, which is the worst possible first five minutes.
#
# So: a key that is genuinely optional is COMMENTED OUT here, never assigned
# empty. Uncomment and fill it to enable that capability.
#
# Checked by `node agent/tools/sync-legal-i18n.test.mjs`-style discipline:
#   cd oracle && npx tsx --env-file=.env.example -e "import('./src/env.ts').then(m=>m.getConfig())"

# Oracle — the AI Tutor runtime (/ORACLE.md). Port 4009.
# Copy to .env for local development. NEVER commit a filled-in .env.

PORT=4009
NODE_ENV=development

# Service-to-service key for Oracle's own internal HTTP surface.
INTERNAL_API_KEY=replace-me-with-a-32-char-random-string

# Shared secret Core signs live-session tokens with (/ORACLE.md §3.2).
# MUST be different from INTERNAL_API_KEY: one authenticates a service, the
# other authenticates a single browser socket. Sharing them means a leaked
# session token can call the internal API.
TUTOR_SESSION_SECRET=replace-me-with-a-64-char-random-string

# Core — the only service that holds learner data. Oracle has no DB access.
CORE_URL=http://localhost:4000
CORE_INTERNAL_KEY=replace-me-0123456789

# Depot — stores the TUTOR's synthesized audio. The learner's audio is never
# stored anywhere (/ORACLE.md §0 decision 8).
DEPOT_URL=http://localhost:4006
DEPOT_INTERNAL_KEY=replace-me-0123456789

# Forge — tier-3 live segment generation (/ORACLE.md §7.3).
COURSEGEN_URL=http://localhost:4001
COURSEGEN_INTERNAL_KEY=replace-me-0123456789

# The pedagogical model. Author = DeepSeek, judge = Qwen, same split as Forge.
# The base URL MUST carry /v1 — the endpoint is built by hand as
# ${MODEL_API_BASE}/chat/completions, so dropping it 404s every turn.
#
# FLASH, not PRO. deepseek-v4-pro is a reasoning model: it spends the whole
# completion budget on reasoning_content and returns empty content. Right for
# Forge, which authors offline; wrong here, where a learner is waiting.
MODEL_API_BASE=https://api.deepseek.com/v1
# MODEL_API_KEY=
MODEL_NAME=deepseek-v4-flash
JUDGE_API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# JUDGE_API_KEY=
JUDGE_MODEL_NAME=qwen3-max

# Real-time voice. `none` is the DEFAULT and a fully supported posture: the
# session runs captioned and silent.
#
# The API surface WAS verified against the live service on 2026-08-21
# (`npm run voices:verify` re-runs that check). What is still outstanding is
# the data-processing agreement covering minors' audio — which is why the
# policy flag below exists separately from this key.
VOICE_PROVIDER=none
INWORLD_API_BASE=https://api.inworld.ai
# Inworld issues this ALREADY base64-encoded (`keyId:secret`). Do not re-encode.
# INWORLD_API_KEY=
# Verified present: inworld-tts-1, inworld-tts-1-max, inworld-tts-2, inworld-tts-2-flash
INWORLD_TTS_MODEL=inworld-tts-1

# THE DPA GATE. While this is false, no minor's microphone opens — regardless
# of guardian consent, which is separate and also required. Adults are
# unaffected and every learner keeps the whole tutor; this gates one input
# method, not the product. Flipping it is an owner decision to record
# (/ORACLE.md §16, /LEGAL/AI_TUTOR_LEGAL_REVIEW.md §6).
TUTOR_VOICE_FOR_MINORS=false

# THE CHARACTER VOICES. The cast already has voices — Echo clones them per
# locale from the owner's reference recordings and narrates every lesson with
# them. The Tutor must use the SAME ones, or a child who knows Dr. Rho from a
# lesson meets a stranger. Populate with `npm run voices:clone -- --confirm`,
# which enrols from the same trimmed samples Echo uses.
#
# An UNSET character is SILENT in that locale — never a stock substitute.
# INWORLD_VOICE_DINA_EN_US=
# INWORLD_VOICE_DINA_ES_MX=
# INWORLD_VOICE_DINA_PT_BR=
# INWORLD_VOICE_LIRUF_EN_US=
# INWORLD_VOICE_LIRUF_ES_MX=
# INWORLD_VOICE_LIRUF_PT_BR=
# INWORLD_VOICE_RHO_EN_US=
# INWORLD_VOICE_RHO_ES_MX=
# INWORLD_VOICE_RHO_PT_BR=
# INWORLD_VOICE_ZARA_EN_US=
# INWORLD_VOICE_ZARA_ES_MX=
# INWORLD_VOICE_ZARA_PT_BR=

# Redis. Backs the rate limiter AND the speech cache. Optional in both roles:
# without it the limiter passes traffic through and a cache miss becomes a paid
# text-to-speech call. Neither is silence and neither is an outage.
REDIS_URL=redis://localhost:6379

# THE SPEECH CACHE (/ORACLE.md §15). Text-to-speech is the most expensive thing
# this service does and most of what it says it has said before. The cache sits
# in front of the paid call and stores a content hash -> Depot URL.
#
# Turning it off is a debugging affordance, not a posture: every line is then
# synthesized and billed again, which is what this existed to stop.
SPEECH_CACHE_ENABLED=true
SPEECH_CACHE_TTL_SECONDS=15552000

# How far a clip may be reused. `scripted` shares only the closed, human-written
# line set — audio identical for every learner that says nothing about anybody.
# `all` also shares model-generated turns between learners, which saves more AND
# changes a documented privacy promise: a shared clip cannot be deleted with one
# child's session, so their tutor's words would outlive the 90-day retention
# window (/ORACLE.md §12). That is an owner decision with counsel in it.
SPEECH_CACHE_SCOPE=scripted

# Session budget (/ORACLE.md §9.5). HARD must exceed SOFT or startup fails.
SESSION_SOFT_BUDGET_MS=900000
SESSION_HARD_BUDGET_MS=1500000
SESSION_MAX_TURNS=120
TURN_MAX_INPUT_CHARS=600
# How long a session may carry no learner frame (keepalive pings excluded)
# before it is closed as abandoned. Bounds the abandoned open tab, which the
# hard budget alone never reaps — that budget is only evaluated when a turn
# arrives.
SESSION_IDLE_TIMEOUT_MS=600000
# How long a dropped session waits, parked in memory, for the browser to
# resume with a fresh Core-minted token before it is finalized as learner_left.
# In-process, like the token nonce ledger — another reason Oracle stays a
# SINGLE replica.
SESSION_RESUME_GRACE_MS=90000

# Hard per-process ceiling on live tutor sessions (/ORACLE.md §15.2 item 2,
# narrow single-process scope). A conservative starting point, not a measured
# capacity figure — raise it once real memory/CPU load is observed.
ORACLE_MAX_CONCURRENT_SESSIONS=200
# The websocket handshake's own rate limit, per IP (/ORACLE.md §15.2 item 3).
# Express's globalRateLimiter never sees this path — see ws/handshakeRateLimit.ts.
# Generous on purpose: a household reconnecting through one NAT'd IP on a
# flaky connection must not be caught by defence-in-depth behind a control
# (Core's token minting) that already works.
ORACLE_WS_HANDSHAKE_RATE_LIMIT_MAX=100
ORACLE_WS_HANDSHAKE_RATE_LIMIT_WINDOW_MS=60000

MODEL_TIMEOUT_MS=20000
VOICE_TIMEOUT_MS=15000
CORE_TIMEOUT_MS=8000

# THE PLATFORM-WIDE SPEND CIRCUIT BREAKER (/ORACLE.md §15.2 item 1). Bounds
# what the PROCESS spends in total, across every session it is holding — the
# turn cap and budget clocks above only bound one session. $20/day is a
# deliberately conservative FIRST default meant to catch a retry storm or a
# multiplying bug, not to model realistic usage; raise it as real paid usage
# grows. In-process and rolling, like SESSION_RESUME_GRACE_MS above — Oracle
# is a single replica, so this is not backed by anything shared.
DAILY_SPEND_CEILING_USD=20
# The fraction of the ceiling that triggers a LOUD warning instead of a
# refusal, so an operator has room to react before a learner is ever turned
# away.
DAILY_SPEND_ALERT_FRACTION=0.5

# The review-sampling rate for live-generated segments lives in CORE
# (TUTOR_LIVE_REVIEW_SAMPLE_RATE), where segments are persisted. The
# LIVE_REVIEW_SAMPLE_RATE that used to sit here was read by nothing.
