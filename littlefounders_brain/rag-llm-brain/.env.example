# .env.example — plantilla de credenciales del cerebro RAG (COPIAR a .env y rellenar).
# El .env real está gitignored (NUNCA se commitea). Esta plantilla SÍ se versiona.
#
# Cómo obtener la API key de Qwen:
#   1. Entra a Alibaba Cloud Model Studio (consola internacional, región Singapur):
#      https://modelstudio.console.alibabacloud.com/  (sección API-KEY del workspace)
#   2. Crea/copia una API key del workspace y su endpoint OpenAI-compatible.
#   3. El proyecto usa el modelo qwen-flash (configurado en knowledge/_meta/build_policy.yaml).
#
# Solo QWEN_API_KEY y QWEN_BASE_URL son OBLIGATORIAS (las lee knowledge/tools/llm_qwen.py).
# QWEN_DASHSCOPE_URL y QWEN_WORKSPACE_ID son informativas (no se usan en código hoy).

QWEN_API_KEY=sk-ws-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
QWEN_BASE_URL=https://<workspace>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
QWEN_DASHSCOPE_URL=https://<workspace>.ap-southeast-1.maas.aliyuncs.com/api/v1
QWEN_WORKSPACE_ID=ws-XXXXXXXXXXXX

# DeepSeek (PLANNER) — OpenAI-compatible. BASE_URL opcional (default https://api.deepseek.com)
DEEPSEEK_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
DEEPSEEK_BASE_URL=https://api.deepseek.com

# z.ai / Zhipu GLM (JUEZ + VERIFICADOR, hoy) — OpenAI-compatible en /api/paas/v4
ZAI_API_KEY=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# MiniMax (MIGRACIÓN GLM→MiniMax, pendiente) — OpenAI-compatible. Cuando exista la key, el juez/verificador
# pueden flipear a MiniMax-M2.5 / MiniMax-M3 en build_policy.yaml (ver bloque MIGRACIÓN allí). BASE_URL
# opcional (default https://api.minimax.io/v1; confirmar región en la consola MiniMax).
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
