PORT=4007

# Service-to-service auth (shared with internal services, /AGENTS.md §1.5)
INTERNAL_API_KEY=replace-me

# Image provider — Qwen-Image-Max on DashScope's synchronous multimodal
# endpoint (decision RESOLVED, see AGENTS.md; Gemini was discarded — image
# models quota-0). NEVER commit a real key. IMAGE_API_BASE has NO path — the
# client appends the model-specific endpoint.
IMAGE_API_BASE=https://dashscope-intl.aliyuncs.com
IMAGE_API_KEY=replace-me
IMAGE_MODEL=qwen-image-max
IMAGE_SIZE=1328*1328

# Art-director judge — OpenAI-compatible chat (DashScope compatible-mode).
# JUDGE_API_KEY is OPTIONAL: leave it unset to reuse IMAGE_API_KEY.
JUDGE_API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# JUDGE_API_KEY=replace-me
JUDGE_MODEL=qwen-plus

# Vault (Supabase self-hosted stack) — service role, bypasses RLS.
# Indexes the picture_assets cache table (migration owned by Vault).
SUPABASE_URL=http://localhost:8000
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Filebase (Depot) — internal upload service; generated images land in the
# lesson-images bucket (public, PII-free media).
FILEBASE_URL=http://localhost:4006
FILEBASE_INTERNAL_KEY=replace-me

# Generation budget — overall wall clock per image, and max transport retries
# (429/5xx only) for each submit/poll HTTP call.
PICTUREGEN_TIMEOUT_MS=120000
PICTUREGEN_MAX_ATTEMPTS=4

# Pictorial verifier — a vision model (same DashScope account) inspects every
# freshly generated image for readable text/numerals; a hit triggers a full
# regeneration from a fresh judge prompt. Attempts INCLUDE the first
# generation; 0 disables verification.
VERIFY_MODEL=qwen-vl-plus
PICTUREGEN_VERIFY_ATTEMPTS=3

# Storage transcode — every generated image is re-encoded WebP at this quality
# before the Depot upload (−96.9% vs qwen-image's PNGs, measured on the live
# corpus; the verifier always inspects the ORIGINAL bytes).
IMAGE_WEBP_QUALITY=82
