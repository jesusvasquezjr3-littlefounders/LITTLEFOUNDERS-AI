PORT=4003

# ---- Service-to-service auth (/AGENTS.md §1.5) ----
# Guards the /api/v1 prefix (x-internal-api-key, constant-time compared).
# Optional: /health, the CLI and every offline command work without it, and the
# guard FAILS CLOSED when it is unset. Minimum 16 chars.
INTERNAL_API_KEY=replace-me-with-a-32-char-internal-key

# ---- Author provider (DeepSeek) — required only for the paid stages of
# `npm run generate` (plan, author, localize). The /health service, `--dry-run`
# and all offline commands (catalog:check, contract:check, tests) never need it.
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro

# ---- Judge provider (Qwen) — deliberately a DIFFERENT provider from the
# author, so the judge's failures are decorrelated from the author's blind spots.
QWEN_API_KEY=replace-me
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_JUDGE_MODEL=qwen3-max

# ---- Prism (picturegen/, port 4007) — the ONLY image source (Gemini discarded
# 2026-07-23: quota-0 on every Google image model). Needed by `illustrate`,
# which runs on the es-MX document BEFORE the localize string-freeze so one
# image serves all three locales. PICTUREGEN_INTERNAL_KEY minimum 16 chars.
PICTUREGEN_URL=http://localhost:4007
PICTUREGEN_INTERNAL_KEY=replace-me-with-the-shared-prism-key

# ---- Vault writes (`publish` — service role, bypasses RLS on purpose;
# game_documents is a service-role-only surface because `validation` is
# server-only). Arcade publishes status='review' and NEVER auto-publishes. ----
SUPABASE_URL=http://localhost:8000
SUPABASE_SERVICE_ROLE_KEY=replace-me

# ---- Run budgets / concurrency (the kill switches; twin of coursegen's
# FORGE_* set). checkBudget() runs before every paid call and its
# BudgetExceededError must PROPAGATE — a cap that a per-item catch swallows is
# not a cap. ----
ARCADE_MAX_TOKENS_PER_RUN=5000000
ARCADE_MAX_USD_PER_RUN=50
ARCADE_MAX_TOKENS_PER_SLOT=150000
ARCADE_MAX_USD_PER_SLOT=0.25
ARCADE_CONCURRENCY=2
ARCADE_SLOT_ATTEMPTS=3
# Request timeouts (ms). A fetch with NO timeout parks a pool worker forever;
# with ARCADE_CONCURRENCY workers a long run can lose them all and hang.
ARCADE_CHAT_TIMEOUT_MS=120000
ARCADE_PICTUREGEN_TIMEOUT_MS=180000
ARCADE_VAULT_TIMEOUT_MS=30000

# ---- Cost table overrides (USD per 1K tokens / per image) — optional; the
# defaults in src/env.ts were verified against the official price pages
# 2026-07-25 (deepseek-v4-pro / DashScope). *_INPUT_CACHED_* = the rate for
# prompt tokens served by the provider's automatic context cache (DeepSeek
# prompt_cache_hit_tokens; DashScope prompt_tokens_details.cached_tokens).
# COST_QWEN_IMAGE_PER_IMAGE is billed per image actually GENERATED — a Prism
# cache hit costs nothing. Override only if pricing changes. ----
# COST_DEEPSEEK_INPUT_PER_1K=0.000435
# COST_DEEPSEEK_INPUT_CACHED_PER_1K=0.0000036
# COST_DEEPSEEK_OUTPUT_PER_1K=0.00087
# COST_QWEN_INPUT_PER_1K=0.0016
# COST_QWEN_INPUT_CACHED_PER_1K=0.00032
# COST_QWEN_OUTPUT_PER_1K=0.0064
# COST_QWEN_IMAGE_PER_IMAGE=0.035
